		function library:apply_theme(instance, theme, property) 
			insert(themes.utility[theme][property], instance)
		end

		function library:update_theme(theme, color)
			for _, property in next, themes.utility[theme] do

				for m, object in next, property do
					if object[_] == themes.preset[theme] or object.ClassName == "UIGradient" then
						object[_] = color
					end
				end
			end

			themes.preset[theme] = color

			-- a flat repaint wipes the per-element two-tone colours, so re-spread
			-- whenever the base colour of a two-toned channel moves
			if library.two_tone and (theme == "accent" or theme == "glow") then
				library:refresh_two_tone()
			end
		end

		-- Two-tone: instead of one flat accent, every accented element takes the colour
		-- at ITS horizontal position across the window — left edge = colour A, right edge
		-- = colour B. Each element stays a flat colour (only the window glow and the top
		-- bar are real gradients), which is what makes the whole menu read as one ramp.
		--
		-- This deliberately bypasses update_theme's `object[_] == preset` guard: that guard
		-- exists so a repaint only touches elements still on the old colour, but here every
		-- element is legitimately a DIFFERENT colour, so it would skip all of them.
		function library:refresh_two_tone()
			local root = library.two_tone_root
			if not (library.two_tone and root and root.Parent) then return end
			local x0, w = root.AbsolutePosition.X, root.AbsoluteSize.X
			if w <= 0 then return end

			local function spread(channel, a, b)
				for property, objects in next, themes.utility[channel] do
					for _, object in next, objects do
						-- UIGradients hold a ColorSequence, not a Color3: give them the
						-- full A->B ramp so big elements (glow, accent bar) sweep properly
						if object.ClassName == "UIGradient" then
							object[property] = rgbseq{rgbkey(0, a), rgbkey(1, b)}
						else
							local ok, pos = pcall(function() return object.AbsolutePosition end)
							local ok2, size = pcall(function() return object.AbsoluteSize end)
							if ok and ok2 then
								-- sample at the element's CENTRE, clamped so popups and
								-- panels parked outside the window still get an endpoint
								local t = math.clamp(((pos.X + size.X * 0.5) - x0) / w, 0, 1)
								object[property] = a:Lerp(b, t)
							end
						end
					end
				end
			end

			spread("accent", themes.preset.accent, library.accent_2 or themes.preset.accent)
			spread("glow",   themes.preset.glow,   library.glow_2   or themes.preset.glow)
		end

