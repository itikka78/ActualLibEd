			function cfg.open_tab()
				if library.current_tab and library.current_tab[1] ~= background then 
					local button = library.current_tab[1]
					button.Size = dim2(1, -2, 1, -1)
					button:FindFirstChildOfClass("UIGradient").Rotation = 90
					button:FindFirstChildOfClass("TextLabel").TextColor3 = themes.preset.text
						
					library.current_tab[2].Visible = false
					
					library.current_tab = nil
				end
				
				library.current_tab = {
					background, section_holder
				}
				
				local button = library.current_tab[1] 
				button.Size = dim2(1, -2, 1, 0) -- ENABLED
				button:FindFirstChildOfClass("UIGradient").Rotation = -90
				button:FindFirstChildOfClass("TextLabel").TextColor3 = themes.preset.accent 

				library.current_tab[2].Visible = true

				-- Quint fade-in of the opened tab's content (ExampleLib FadeDescendants port):
				-- every descendant's transparency props snap to 1 then tween back to their real
				-- value, so the page eases in instead of popping.
				do
					local info = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
					local function fade_props(o)
						if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
							return {"TextTransparency", "BackgroundTransparency"}
						elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
							return {"ImageTransparency", "BackgroundTransparency"}
						elseif o:IsA("ScrollingFrame") or o:IsA("Frame") then
							return {"BackgroundTransparency"}
						elseif o:IsA("UIStroke") then
							return {"Transparency"}
						end
					end
					local objs = section_holder:GetDescendants()
					objs[#objs + 1] = section_holder
					for _, o in next, objs do
						local p = fade_props(o)
						if p then
							for _, prop in next, p do
								local ok, target = pcall(function() return o[prop] end)
								if ok and target < 1 then
									o[prop] = 1
									tween_service:Create(o, info, {[prop] = target}):Play()
								end
							end
						end
					end
				end

				if library.current_element_open and library.current_element_open ~= cfg then
					library.current_element_open.set_visible(false)
					library.current_element_open.open = false 
					library.current_element_open = nil 
				end
			end
			
			tab_holder.MouseButton1Click:Connect(function()
				library:ui_sound("click")
				cfg.open_tab()
			end)
			
			return setmetatable(cfg, library) 
		end

