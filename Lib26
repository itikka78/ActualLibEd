							return
						end
						if PRESET_FONTS[sel] then
							local ok, err = pcall(function()
								local f = type(PRESET_FONTS[sel]) == "function" and PRESET_FONTS[sel]() or PRESET_FONTS[sel]
								applyLibFont(f)
							end)
							if ok then
								library:notification({text = "Applied: " .. sel, time = 3})
							else
								library:notification({text = "Preset error: " .. tostring(err), time = 5})
							end
							return
						end
						local filename = sel:match("[^\\/]+$") or sel
						local path = fontPathMap[filename]
						if not path then
							library:notification({text = "Not found – hit Refresh first", time = 4})
							return
						end
						local ok, err = pcall(function()
							-- normalize backslashes from listfiles
							local norm_path = path:gsub("\\", "/")
							local ttf_asset = getcustomasset(norm_path)
							assert(ttf_asset and ttf_asset ~= "", "getcustomasset failed: " .. norm_path)
							local font_name = filename:gsub("%.[^%.]+$", "")
							local descriptor = http_service:JSONEncode({
								name = font_name,
								faces = {{
									name = "Regular",
									weight = 400,
									style = "normal",
									assetId = ttf_asset
								}}
							})
							-- write to root with .ttf extension, same pattern as library's own font loading
							writefile("_atl_font.ttf", descriptor)
							local json_asset = getcustomasset("_atl_font.ttf")
							assert(json_asset and json_asset ~= "", "descriptor getcustomasset failed")
							applyLibFont(Font.new(json_asset, Enum.FontWeight.Regular))
						end)
						if ok then
							library:notification({text = "Applied: " .. filename, time = 3})
						else
							library:notification({text = "Font error: " .. tostring(err), time = 5})
						end
					end})
