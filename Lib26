		library._last_ui_sound = {}
		function library:ui_sound(kind)
			local style = flags["ui_" .. kind .. "_style"]
			if not style or style == "Off" then return end
			local id
			if style == "Custom" then
				id = tostring(flags["ui_" .. kind .. "_custom"] or ""):gsub("%s", "")
				if id == "" then return end
				if not id:find("rbxassetid://", 1, true) then id = "rbxassetid://" .. id end
			else
				id = library.ui_sound_presets[style]
			end
			if not id then return end
			local now = os.clock()
			if now - (library._last_ui_sound[kind] or 0) < 0.05 then return end
			library._last_ui_sound[kind] = now
			pcall(function()
				local snd = Instance.new("Sound")
				snd.SoundId = id
				snd.Volume = flags["ui_" .. kind .. "_vol"] or 1
				snd.Parent = sound_service
				snd:Play()
				debris:AddItem(snd, 2)
			end)
		end

