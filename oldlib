									Parent = o.holder; Name = "\0"; ZIndex = 1; Visible = false;
									BackgroundColor3 = rgb(255, 255, 255); BorderSizePixel = 0;
									Size = dim2(1, 0, 1, 0); Position = dim2(0, 0, 0, 0);
