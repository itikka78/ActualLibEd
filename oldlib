					watermark_outline.Visible = bool
				end

				-- Shimmer (ExampleLib port): a bright accent-colored shine sweeps across the text,
				-- per-character (RichText color lerp text -> accent), and the top accent bar's
				-- gradient sweeps with it. Reads the LIVE theme each tick, so an animated accent
				-- carries straight into the shimmer. Throttled to ~30hz to keep string churn cheap.
				do
					local phase, last, shine_width = 0, tick(), 6
					library:connection(run.RenderStepped, function()
						if not watermark_outline.Visible then return end
						local now = tick()
						if now - last < (1 / 30) then return end
						phase = (phase + (now - last) * (1 / 1.2)) % 1
						last = now

						local body      = "  " .. plain_text .. "  "
						local shine_pos = phase * (#body + shine_width)
						local text_col  = themes.preset.text
						local accent_col= themes.preset.accent
						local rich = {}
						for i = 1, #body do
							local dist = math.abs(i - shine_pos)
							local a    = math.clamp(1 - (dist / shine_width), 0, 1)
							local c    = text_col:Lerp(accent_col, a)
							rich[i] = string.format('<font color="rgb(%d,%d,%d)">%s</font>',
								math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255),
								body:sub(i, i))
						end
						text.Text = table.concat(rich)
						accent_shine.Offset = vec2((phase * 2) - 1, 0)
					end)
				end

				cfg.change_text(cfg.default)

				return cfg

			end

			function library:esp_preview(properties)
				local cfg = {items = {}, rotation = 0; objects = {};}

				local character = nil
				if lp.Character then
					lp.Character.Archivable = true
					character = lp.Character:Clone()
					character.Animate:Destroy()
				end

				local items = cfg.items; do
					items.viewportframe = library:create( "ViewportFrame" , {
						Parent = self.holder;
						BackgroundTransparency = 1;
						ClipsDescendants = true;   -- box/tags/skeleton can never spill past the panel
						Size = dim2(1, 0, 0, 220);
						BorderColor3 = rgb(0, 0, 0);
						ZIndex = 1;
						Position = dim2(0, 0, 0, 10);
						BorderSizePixel = 0;
						BackgroundColor3 = rgb(255, 255, 255)
					});

					items.camera = library:create( "Camera" , {
						FieldOfView = 70.00022888183594;
						CameraType = Enum.CameraType.Track;
						Focus = cfr(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1); -- bro wtf is this serializer doing
						CFrame = cfr(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1);
						Parent = ws;
						Name = "\0"
					});

					items.viewportframe.CurrentCamera = items.camera -- sick

					if character then
						character.Parent = items.viewportframe
						items.camera.CameraSubject = character
					end

					-- NH-style preview: the model faces you by default instead of auto-spinning.
					-- Drag inside the viewport to orbit it; on release it eases back to the front
					-- view. Resilient to the character being swapped/refreshed (character upvalue).
					local FRONT = 180                 -- 180° faces the tracking camera (front-facing)
					cfg.rotation = FRONT
					cfg.target_rotation = FRONT
					local dragging, drag_start_x, drag_start_rot = false, 0, FRONT

					items.viewportframe.Active = true   -- so the viewport captures mouse input
					library:connection(items.viewportframe.InputBegan, function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							dragging = true
							drag_start_x = input.Position.X
							drag_start_rot = cfg.rotation
						end
					end)
					library:connection(uis.InputChanged, function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
							or input.UserInputType == Enum.UserInputType.Touch) then
							cfg.rotation = drag_start_rot + (input.Position.X - drag_start_x) * 0.6
							cfg.target_rotation = cfg.rotation
						end
					end)
					library:connection(uis.InputEnded, function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch) then
							dragging = false
							cfg.target_rotation = FRONT   -- let the per-frame ease glide it home
						end
					end)

					-- project a world point into the viewport frame's local pixel space. The viewport
					-- has its own plain Camera (not the real one), so do the perspective divide by
					-- hand off its live CFrame + FOV against the frame's on-screen size.
					local function vp_project(world_pos)
						local cam = items.camera
						local vp = items.viewportframe.AbsoluteSize
						if vp.X <= 0 or vp.Y <= 0 then return nil end
						local rel = cam.CFrame:PointToObjectSpace(world_pos)
						local depth = -rel.Z
						if depth <= 0.05 then return nil end
						local tan_half = math.tan(math.rad(cam.FieldOfView) * 0.5)
						local aspect = vp.X / vp.Y
						local sx = ( rel.X / (depth * tan_half * aspect) * 0.5 + 0.5) * vp.X
						local sy = (-rel.Y / (depth * tan_half)          * 0.5 + 0.5) * vp.Y
						return vec2(sx, sy), depth
					end

					-- size + place the box exactly like the real player ESP: Dynamic projects the
					-- root's up-axis for a torso-anchored, fixed-aspect box; Static scales by depth.
					-- Everything (name / hp / distance / corners) hangs off the holder, so the whole
					-- tag rides the box — it's drawn ONTO the character, not floated over it.
					local function update_preview_box()
						local hrp = character and character.PrimaryPart
						local holder = cfg.objects.holder
						if not (hrp and holder) then return end
						local hpos = hrp.Position
						local w, h, cx, cy
						if flags["Box_Sizing"] == "Static" then
							local sp, depth = vp_project(hpos)
							if not sp then return end
							local sf = items.viewportframe.AbsoluteSize.Y
								/ (2 * depth * math.tan(math.rad(items.camera.FieldOfView) * 0.5))
							h = math.max(sf * (flags["Static_Box_Y"] or 5), 10)
							w = math.max(sf * (flags["Static_Box_X"] or 2.5), 8)
							cx, cy = sp.X, sp.Y
						else
							local up = hrp.CFrame.UpVector
							local spT = vp_project(hpos + up * 2)
							local spB = vp_project(hpos - up * 2.8)
							if not (spT and spB) then return end
							local raw_h = math.abs(spB.Y - spT.Y)
							if raw_h <= 0 then return end
							local pad = flags["Dynamic_Box_Padding"] or 1
							h  = raw_h * pad
							w  = (raw_h / 1.5) * pad
							cx = (spT.X + spB.X) * 0.5
							cy = math.min(spT.Y, spB.Y) + raw_h * 0.5
						end
						holder.Size = dim2(0, w, 0, h)
						holder.Position = dim2(0, cx, 0, cy)
					end

					-- the R15 bone pairs the real ESP skeleton draws, projected into the viewport
					local PREVIEW_BONES = {
						{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
						{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
						{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
						{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
						{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
					}
					local mat_saved = {}   -- Enemy Material restore cache { part -> {mat, col, transp} }

					-- Per-frame ESP elements that can't be a plain reparent: chams, enemy material,
					-- head dot and skeleton (both projected), and the ammo-fill fraction. Reads the
					-- live player-ESP flags so the preview reacts to every toggle — the base a future
					-- ESP builder edits against.
					local function update_preview_overlays()
						local o = cfg.objects
						if not (character and o) then return end
						-- skip the heavy work (projection / material recolor) while the menu is closed
						if not cfg._preview_sg then cfg._preview_sg = items.viewportframe:FindFirstAncestorWhichIsA("ScreenGui") end
						if cfg._preview_sg and not cfg._preview_sg.Enabled then return end
						local enabled = flags["Enabled"]
						-- builder toggle state for the global visuals (box/skeleton/chams/head_dot).
						-- nil until the ESP builder wires up -> fall back to the real flags.
						local B = cfg._show

						-- Chams: when the builder is up (B), a cheap smaller box INSIDE the main box
						-- (no per-frame Highlight cost). The real Highlight only runs in the
						-- non-builder fallback (B == nil).
						if o.chams_box then
							local cham_on = enabled and (B and B.chams) == true
							o.chams_box.Visible = cham_on
							if cham_on then
								local fc = flags["Chams_Fill_Color"]
								if fc and fc.Color then
									o.chams_box.BackgroundColor3 = fc.Color
									local st = o.chams_box:FindFirstChildOfClass("UIStroke")
									if st then st.Color = fc.Color end
								end
							end
						end
						if o.chams then
							if not B and enabled and flags["Chams"] then
								o.chams.Adornee = character
								local oc = flags["Chams_Outline"];     if oc and oc.Color then o.chams.OutlineColor = oc.Color end
								local fc = flags["Chams_Fill_Color"];  if fc and fc.Color then o.chams.FillColor    = fc.Color end
								o.chams.OutlineTransparency = flags["Chams_Outline_On"] and (1 - (flags["Chams_Outline_Opacity"] or 100) / 100) or 1
								o.chams.FillTransparency    = flags["Chams_Fill"]       and (1 - (flags["Chams_Fill_Opacity"]    or 100) / 100) or 1
								o.chams.Enabled = true
							else
								o.chams.Enabled = false
							end
						end

						-- Enemy Material (recolor the viewport character; restored on toggle-off)
						if enabled and flags["esp_mat_enabled"] then
							local ok, mat = pcall(function() return Enum.Material[flags["esp_mat_choice"] or "Neon"] end)
							if not ok then mat = Enum.Material.Neon end
							local col = (flags["esp_mat_color_on"] and flags["esp_mat_color"] and flags["esp_mat_color"].Color) or nil
							local tr  = math.clamp((flags["esp_mat_transp"] or 0) / 100, 0, 0.99)
							for _, p in ipairs(character:GetDescendants()) do
								if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
									if mat_saved[p] == nil then mat_saved[p] = {p.Material, p.Color, p.Transparency} end
									p.Material = mat
									if col then p.Color = col end
									if mat_saved[p][3] < 1 then p.Transparency = tr end
								end
							end
						elseif next(mat_saved) then
							for p, s in pairs(mat_saved) do
								if p.Parent then pcall(function() p.Material = s[1]; p.Color = s[2]; p.Transparency = s[3] end) end
								mat_saved[p] = nil
							end
						end

						-- Head dot (projected onto the head)
						if o.head_dot then
							local head = character:FindFirstChild("Head")
							local sp = (enabled and ((B and B.head_dot) or (not B and flags["HeadDot"])) and head) and vp_project(head.Position) or nil
							if sp then
								local sz = (flags["headdot_size"] or 4) * 1.6
								o.head_dot.Size = dim2(0, sz, 0, sz)
								o.head_dot.Position = dim2(0, sp.X, 0, sp.Y)
								local c = flags["HeadDot_Color"]; if c and c.Color then o.head_dot.BackgroundColor3 = c.Color end
								o.head_dot.Visible = true
							else
								o.head_dot.Visible = false
							end
						end

						-- Skeleton: when the builder is up (B), a cheap tiny box near the centre — no
						-- per-frame joint projection at all. The real projected rig only runs in the
						-- non-builder fallback (B == nil).
						if o.skel_box then
							local skel_on = enabled and (B and B.skeleton) == true
							o.skel_box.Visible = skel_on
							if skel_on then
								local col = flags["Skeleton_Color"]
								if col and col.Color then
									o.skel_box.BackgroundColor3 = col.Color
									local st = o.skel_box:FindFirstChildOfClass("UIStroke")
									if st then st.Color = col.Color end
								end
							end
						end
						-- Skeleton (projected joints -> rotated thin frames)
						if o.skel_lines then
							if not B and enabled and flags["Skeleton"] then
								local col = flags["Skeleton_Color"]; col = (col and col.Color) or rgb(255, 255, 255)
								local th = flags["skel_thickness"] or 2
								for i, bone in ipairs(PREVIEW_BONES) do
									local line = o.skel_lines[i]
									local a = character:FindFirstChild(bone[1])
									local b = character:FindFirstChild(bone[2])
									local pa = a and vp_project(a.Position) or nil
									local pb = b and vp_project(b.Position) or nil
									if line and pa and pb then
										local d = pb - pa
										line.Size = dim2(0, d.Magnitude, 0, th)
										line.Position = dim2(0, (pa.X + pb.X) / 2, 0, (pa.Y + pb.Y) / 2)
										line.Rotation = math.deg(math.atan2(d.Y, d.X))
										line.BackgroundColor3 = col
										line.Visible = true
									elseif line then
										line.Visible = false
									end
								end
							else
								for _, line in ipairs(o.skel_lines) do line.Visible = false end
							end
						end

						-- Ammo bar fill (static 70% showcase; colours set in refresh_elements). Grows
						-- left->right on a horizontal bar (top/bottom), bottom->up on a vertical one.
						if o.ammo_fill then
							if cfg._bar_horiz and cfg._bar_horiz.ammo then
								o.ammo_fill.AnchorPoint = vec2(0, 0); o.ammo_fill.Position = dim2(0, 0, 0, 0); o.ammo_fill.Size = dim2(0.7, 0, 1, 0)
							else
								o.ammo_fill.AnchorPoint = vec2(0, 1); o.ammo_fill.Position = dim2(0, 0, 1, 0); o.ammo_fill.Size = dim2(1, 0, 0.7, 0)
							end
						end

						-- Distance readout: live unit (m / st, follows the esp_dist_unit dropdown) with
						-- a number tweening 0..100 so it reads as a real distance ticking.
						if o.distance then
							local suffix = (flags["esp_dist_unit"] == "Studs") and "st" or "m"
							local v = math.floor((math.sin(tick() * 0.6) * 0.5 + 0.5) * 100 + 0.5)
							o.distance.Text = v .. suffix
						end

						-- Ammo counter under the bar: shown only while Ammo Counter is on; the count
						-- matches the (static 70%) fill so the number lines up with the bar.
						if o.ammo_text then
							local on = flags["Ammo_Counter"] == true
							o.ammo_text.Visible = on
							if on then
								local tc = flags["Ammo_Counter_Color"]
								if tc and tc.Color then o.ammo_text.TextColor3 = tc.Color end
								o.ammo_text.Text = "21 / 30"
							end
						end

						-- Box FILL + gradients + Animated Box (preview fidelity). The static preview
						-- box only drew a solid outline, so Fill Opacity, the Box_Color/Box_Fill
						-- gradients and the rotating "Animated Box" sweep never showed. A fill frame
						-- behind the box carries the fill gradient; the outline stroke gets a gradient
						-- too; "Animated Box" spins both. Gated on box placement like the outline (no
						-- master-Enabled requirement), so it matches when the box is drawn.
						if o.holder then
							local box_on = (B and B.box == true) or (not B and flags["Boxes"] == true)
							if not o.box_fill then
								-- ZIndex 1 (not 0): a ViewportFrame occludes 2D children at ZIndex 0
								-- behind its 3D scene, which is why the fill never showed while the
								-- outline (default ZIndex 1) did. Translucent, so the outline reads
								-- through it even though it's the same layer.
