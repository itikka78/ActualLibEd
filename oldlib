			-- ── shared drag dispatcher ─────────────────────────────────────────────
			-- Sliders, colorpickers, draggable frames and resizable windows used to each
			-- register their OWN global InputChanged/InputEnded connection — hundreds of
			-- handlers fired on EVERY mouse movement with a full menu. Instead, an element
			-- sets library.active_drag = fn(input) on its mouse-down; these TWO connections
			-- forward mouse moves to it and clear it on release. (Raw :Connect + manual
			-- insert because library:connection is defined further down this file.)
			library.active_drag = nil
			insert(library.connections, uis.InputChanged:Connect(function(input)
				local h = library.active_drag
				if h and input.UserInputType == Enum.UserInputType.MouseMovement then h(input) end
			end))
			insert(library.connections, uis.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					if library.active_drag_release then
						local rel = library.active_drag_release
						library.active_drag_release = nil
						pcall(rel)
					end
					library.active_drag = nil
				end
			end))

			function library:make_resizable(frame) 
				local Frame = Instance.new("TextButton")
				Frame.Position = dim2(1, -10, 1, -10)
				Frame.BorderColor3 = rgb(0, 0, 0)
				Frame.Size = dim2(0, 10, 0, 10)
				Frame.BorderSizePixel = 0
				Frame.BackgroundColor3 = rgb(255, 255, 255)
				Frame.Parent = frame
				Frame.BackgroundTransparency = 1 
				Frame.Text = ""

				local start_size
				local start
				local og_size = frame.Size

				Frame.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						start = input.Position
						start_size = frame.Size
						-- resize via the ONE shared dispatcher (was a global InputChanged per window)
						library.active_drag = function(inp)
							local viewport_x = camera.ViewportSize.X
							local viewport_y = camera.ViewportSize.Y
							-- lower width floor is dynamic: a 3-lane page raises library.min_widths[frame]
							-- so the window can't be dragged narrow enough to clip the extra lane.
							local min_x = (library.min_widths and library.min_widths[frame]) or og_size.X.Offset
							frame.Size = dim2(
								start_size.X.Scale,
								math.clamp(start_size.X.Offset + (inp.Position.X - start.X), min_x, viewport_x),
								start_size.Y.Scale,
								math.clamp(start_size.Y.Offset + (inp.Position.Y - start.Y), og_size.Y.Offset, viewport_y)
							)
						end
					end
				end)
			end

			-- Aero Snap overlay (lazy): a hollow accent outline shown while dragging a
			-- window with "Aero Snap" on (the window itself only moves on release), plus
			-- center alignment guides that pop whenever a drag nears the screen middle.
			local function ensure_snap_gui()
				if library._snap_outline then return end
				local g = library:create("ScreenGui", {
					Parent = gethui(),
					Name = "",
					DisplayOrder = 2000000,
					-- MUST match the windows' coord space (they're IgnoreGuiInset now): the Aero
					-- ghost + center guides live here and are positioned from the frame's no-inset
					-- Position offsets. Without this the ghost renders ~36px (the topbar inset) off,
					-- so snapping to the top overshoots and the window lands partly off-screen.
					IgnoreGuiInset = true,
				})
				local outline = library:create("Frame", {
					Parent = g,
					Name = "",
					BackgroundColor3 = themes.preset.accent,
					BackgroundTransparency = 0.9,
					BorderSizePixel = 0,
					Visible = false,
				}) library:apply_theme(outline, "accent", "BackgroundColor3")
				local stroke = library:create("UIStroke", {
					Parent = outline,
					Thickness = 1,
					Color = themes.preset.accent,
					LineJoinMode = Enum.LineJoinMode.Miter,
				}) library:apply_theme(stroke, "accent", "Color")
				library._snap_outline = outline
				library._guide_v = library:create("Frame", {
					Parent = g,
					Name = "",
					AnchorPoint = vec2(0.5, 0),
					Position = dim2(0.5, 0, 0, 0),
					Size = dim2(0, 1, 1, 0),
					BorderSizePixel = 0,
					BackgroundColor3 = themes.preset.accent,
					Visible = false,
				}) library:apply_theme(library._guide_v, "accent", "BackgroundColor3")
				library._guide_h = library:create("Frame", {
					Parent = g,
					Name = "",
					AnchorPoint = vec2(0, 0.5),
					Position = dim2(0, 0, 0.5, 0),
					Size = dim2(1, 0, 0, 1),
					BorderSizePixel = 0,
					BackgroundColor3 = themes.preset.accent,
					Visible = false,
				}) library:apply_theme(library._guide_h, "accent", "BackgroundColor3")
			end

			function library:draggify(frame, key, handle)
				-- `handle` (optional): only THIS object starts the drag, while `frame` still moves.
				-- Lets a window drag from just its title bar instead of anywhere in the body.
				local start_size = frame.Position
				local start

				-- config-saved positions: a draggable passed a stable `key` is registered here so
				-- capture_ui_positions can snapshot its Position on save and restore it on load.
				if key then
					library.ui_draggables = library.ui_draggables or {}
					library.ui_draggables[key] = frame
				end

				(handle or frame).InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						start = input.Position
						start_size = frame.Position

						if library.current_element_open then
							library.current_element_open.set_visible(false)
							library.current_element_open.open = false
							library.current_element_open = nil
						end

						if frame.Parent:IsA("ScreenGui") and frame.Parent.DisplayOrder ~= 999999 then
							library.display_orders += 1 -- shit code
							frame.Parent.DisplayOrder = library.display_orders
						end

						-- overlay build is pcalled + gated: if it ever fails, dragging still
						-- works normally (no aero / no guides instead of a dead handler)
						pcall(ensure_snap_gui)
						local snap_ok = library._snap_outline ~= nil and library._guide_v ~= nil and library._guide_h ~= nil
						local aero = snap_ok and flags["aero_snap"] == true
						local target_x, target_y = start_size.X.Offset, start_size.Y.Offset
						if aero then
							library._snap_outline.Position = dim2(0, target_x - frame.AbsoluteSize.X * frame.AnchorPoint.X, 0, target_y - frame.AbsoluteSize.Y * frame.AnchorPoint.Y)
							library._snap_outline.Size = dim2(0, frame.AbsoluteSize.X, 0, frame.AbsoluteSize.Y)
							library._snap_outline.Visible = true
						end

						-- drag via the ONE shared dispatcher (was a global InputChanged per frame)
						library.active_drag = function(inp)
							local viewport_x = camera.ViewportSize.X
							local viewport_y = camera.ViewportSize.Y
							local x = clamp(start_size.X.Offset + (inp.Position.X - start.X), 0, viewport_x - frame.Size.X.Offset)
							local y = clamp(start_size.Y.Offset + (inp.Position.Y - start.Y), 0, viewport_y - frame.Size.Y.Offset)
							local tx, ty = x, y
							if snap_ok then
								-- center alignment: when the frame's middle nears a screen center
								-- axis, snap onto it and pop the matching guide line (any drag mode)
								local w, h = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
								local ax, ay = frame.AnchorPoint.X, frame.AnchorPoint.Y
								tx, ty = x - w * ax, y - h * ay
								if abs((tx + w * 0.5) - viewport_x * 0.5) <= 10 then
									x = viewport_x * 0.5 - w * 0.5 + w * ax
									tx = x - w * ax
									library._guide_v.Visible = true
								else
									library._guide_v.Visible = false
								end
								if abs((ty + h * 0.5) - viewport_y * 0.5) <= 10 then
									y = viewport_y * 0.5 - h * 0.5 + h * ay
									ty = y - h * ay
									library._guide_h.Visible = true
								else
									library._guide_h.Visible = false
								end
							end
							target_x, target_y = x, y
							if aero then
								library._snap_outline.Position = dim2(0, tx, 0, ty)
							else
								frame.Position = dim2(0, x, 0, y)
							end
						end
						library.active_drag_release = function()
							if snap_ok then
								library._snap_outline.Visible = false
								library._guide_v.Visible = false
								library._guide_h.Visible = false
							end
							if aero then
								frame.Position = dim2(0, target_x, 0, target_y)
							end
						end
					end
				end)
			end

