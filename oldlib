								local c2 = (flags["Box_Color_2"] and flags["Box_Color_2"].Color) or rgb(0, 0, 0)
								local f1 = (flags["Box_Fill_Color"] and flags["Box_Fill_Color"].Color) or rgb(255, 255, 255)
								local f2 = (flags["Box_Fill_Color_2"] and flags["Box_Fill_Color_2"].Color) or rgb(0, 0, 0)
								local fillOp = math.clamp((flags["box_fill_opacity"] or 15) / 100, 0, 1)
								local rot = (flags["Box_Animated"] == true) and ((tick() * 120) % 360) or 90
								o.box_fill_grad.Color = rgbseq{rgbkey(0, f1), rgbkey(1, f2)}
								o.box_fill_grad.Rotation = rot
								o.box_fill.BackgroundTransparency = 1 - fillOp
								o.box_fill.Visible = true
								if o.box_color_grad then
