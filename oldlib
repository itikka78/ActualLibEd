			-- library:subgroup — inline replacement for :plus. Instead of a floating "+" popup,
			-- the sub-options render indented directly UNDER the driving element (reusing the
			-- indent_group guide-rail look), and their visibility follows the driver's state:
			-- a toggle reveals them while ON, a dropdown while it has a selection. Same chaining
			-- API as :plus — :toggle/:slider/:dropdown/... parent INTO cfg.holder:
			--   someToggle:subgroup({name = "Options"})
			--       :slider({name = "Volume", flag = "opt_vol", min = 0, max = 10})
			-- (options.name/max_height/width/height are accepted for drop-in compatibility with
			-- :plus but only the inline look is drawn — height is automatic.)
			function library:subgroup(options)
				options = options or {}
				local cfg = { open = false }
				-- the driver (toggle/dropdown) exposes parent_holder = its section holder, so the
				-- group lands right below it in creation order. Fall back to self.holder so a bare
				-- :subgroup still parents somewhere sane.
				local parent_holder = self.parent_holder or self.holder

				local wrap = library:create("Frame", {
					Parent = parent_holder,
					Name = "",
					Size = dim2(1, -8, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BorderSizePixel = 0,
					BackgroundTransparency = 1,
					Visible = false,   -- hidden until the driver turns it on (UIListLayout skips it)
					BackgroundColor3 = rgb(255, 255, 255)
				})

				local rail = library:create("Frame", {
					Parent = wrap,
					Name = "",
					Position = dim2(0, 5, 0, 0),
					Size = dim2(0, 1, 1, -6),
					BorderSizePixel = 0,
					BackgroundColor3 = themes.preset.inline
				}) library:apply_theme(rail, "inline", "BackgroundColor3")

				local elements = library:create("Frame", {
					Parent = wrap,
					Name = "",
					Position = dim2(0, 14, 0, 0),
					Size = dim2(1, -14, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BorderSizePixel = 0,
					BackgroundTransparency = 1,
					BackgroundColor3 = rgb(255, 255, 255)
				})

				library:create("UIListLayout", {
					Parent = elements,
					Padding = dim(0, 4),
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder
				})

				cfg.holder = elements
				cfg.current_holder = elements
				cfg.wrap = wrap

				function cfg.set_open(bool)
					cfg.open = bool and true or false
					wrap.Visible = cfg.open
				end

				-- bind to the driver's on/off (toggle) or selection (dropdown) state so it
				-- reveals/hides automatically. attach_subgroup also sets the initial state.
				if self.attach_subgroup then self.attach_subgroup(cfg) end

				return setmetatable(cfg, library)
			end

