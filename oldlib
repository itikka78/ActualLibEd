						end

						function library:font_list_update()
							if not font_holder then return end
							local dir = library.directory .. "/fonts"
							if not isfolder(dir) then pcall(makefolder, dir) end
							local list = {}
							fontPathMap = {}
							for _, name in ipairs(PRESET_ORDER) do
								list[#list + 1] = name
							end
							for _, file in next, listfiles(dir) do
								local name = file:match("[^\\/]+$")
								if name and (name:lower():match("%.ttf$") or name:lower():match("%.otf$")) then
									list[#list + 1] = name
									fontPathMap[name] = file
								end
							end
							font_holder.refresh_options(list)
						end

