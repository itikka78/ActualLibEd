		-- Local image assets (dock icons, glows) live in the /images folder made above,
		-- next to the configs and fonts. Anything not on disk is fetched once on first run,
		-- so a fresh install gets real icons instead of blank buttons. The fallback keeps
		-- the old uploaded rbxassetid in play if the download or getcustomasset fails, and
		-- a failure is cached as `false` so a dead link isn't retried on every lookup.
		library.image_url = "https://raw.githubusercontent.com/itikka78/ActualLibEd/refs/heads/main/images/"
		local image_cache = {}
		function library:image(name, fallback)
			local hit = image_cache[name]
			if hit ~= nil then return hit or fallback end
			local id
			-- a real PNG opens with the 0x89 'PNG' magic; a GitHub 404 is a short
			-- "404: Not Found" TEXT body. Some executors return that body from HttpGet
			-- instead of erroring, so we validate the BYTES before trusting a file.
			local PNG_MAGIC = "\137PNG\r\n\26\n"
			pcall(function()
				local path = library.directory .. "/images/" .. name
				local need_download = not isfile(path)
				if not need_download then
					-- validate a file already on disk too: a prior session (before this
					-- check) may have written a 404 body here, which would otherwise load
					-- as a blank asset. Purge a bad one so it re-downloads (and a truly
					-- missing image then 404s -> cached as a miss -> caller gets fallback).
					local ok_read, existing = pcall(readfile, path)
					if ok_read and type(existing) == "string" and existing:sub(1, 8) ~= PNG_MAGIC then
						pcall(delfile, path)
						need_download = true
					end
					-- if readfile failed, assume the file is fine (don't nuke a valid icon)
				end
				if need_download then
					local data = game:HttpGet(library.image_url .. name)
					if type(data) ~= "string" or data:sub(1, 8) ~= PNG_MAGIC then
						return   -- leave id nil -> cached as a miss
					end
					writefile(path, data)
				end
				id = getcustomasset(path)
			end)
			if id == "" then id = nil end
			image_cache[name] = id or false
			return id or fallback
		end

		-- Icon Style: the dock/panel icons can switch between the shipped "Basic" set and a
		-- "Custom" set that mirrors each base name with a 2 suffix (main.png -> main2.png).
		-- Panels register their dock ImageLabel here as they're built (see register_icon in
		-- :window); apply_icon_style re-resolves each one. A missing custom file just falls
		-- back to the base rbxassetid, so Custom degrades to looking like Basic until uploaded.
		library.icon_panels = {}
		function library:apply_icon_style(style)
			local custom = style == "Custom"
			for _, e in ipairs(library.icon_panels) do
				if e.icon and e.icon.Parent then
					if custom then
						-- nil fallback so a missing custom file resolves to nil (not the base
						-- rbxassetid), letting us detect the miss, use the basic icon instead,
						-- and report exactly which custom file wasn't found.
						local img = library:image(e.custom, nil)
						if img == nil then
							library:log("Icon Style: '" .. e.custom .. "' not found - using basic icon", "WARN")
							img = library:image(e.base, e.fallback)
						end
						e.icon.Image = img
					else
						e.icon.Image = library:image(e.base, e.fallback)
					end
				end
			end
		end

		-- Debug output. Anything in the script can push a line to the Output panel with
		-- library:log("text", "WARN"). Levels: INFO / WARN / SUCCESS / ERROR / DEBUG.
		-- Calls made before that panel exists (library init, or anything before :window()
		-- runs) are buffered and flushed when it opens, so early startup lines — usually
		-- the ones you most want to see — aren't silently dropped.
		library.log_buffer = {}
		function library:log(text, level)
			local entry = {text = tostring(text), level = string.upper(tostring(level or "INFO"))}
			if library.console then
				library.console.add(entry.text, entry.level)
			else
				insert(library.log_buffer, entry)
			end
			return entry
		end

