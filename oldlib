				function cfg.set(bool)
					library:tween(accent, {BackgroundTransparency = bool and 0 or 1})
					flags[cfg.flag] = bool
					-- keep the click-state tracker in sync. Without this, a config/autoload that
					-- sets a toggle via cfg.set leaves cfg.enabled stale, so the NEXT click computes
					-- `not <stale>` and eats/inverts itself — the "toggle stuck at wrong state after
					-- rejoin" bug. Now set() is the single source of truth whoever calls it.
					cfg.enabled = bool

					-- reveal/hide any inline subgroups chained off this toggle
					if cfg.subgroups then
						for _, sub in ipairs(cfg.subgroups) do sub.set_open(bool) end
					end

					cfg.callback(bool)
				end

				-- register an inline subgroup so it opens with this toggle (initial state
				-- from the live flag, since the default was already applied above)
				function cfg.attach_subgroup(sub)
					insert(cfg.subgroups, sub)
					sub.set_open(flags[cfg.flag] and true or false)
				end

				function cfg.set_element_visible(bool)
					toggle_holder.Visible = bool
					-- hiding the toggle hides its inline subgroups; showing it restores them
					-- to the toggle's live on/off state (not force-open)
					if cfg.subgroups then
						for _, sub in ipairs(cfg.subgroups) do
							sub.set_open(bool and (flags[cfg.flag] and true or false))
						end
					end
				end
			
				library:connection(toggle_holder.MouseButton1Click, function()
					library:ui_sound("click")
					cfg.enabled = not cfg.enabled
			
					cfg.set(cfg.enabled)
				end)

				library:connection(toggle.MouseButton1Click, function()
					library:ui_sound("click")
					cfg.enabled = not cfg.enabled
			
					cfg.set(cfg.enabled)
				end)

				if cfg.tooltip then 
					library:tool_tip({name = cfg.tooltip, path = toggle_holder})
				end

				cfg.set(cfg.default)
				
				cfg.set_element_visible(cfg.visible)
				
				library.config_flags[cfg.flag] = cfg.set
				library.visible_flags[cfg.flag] = cfg.set_element_visible

				return setmetatable(cfg, library)
			end
			
