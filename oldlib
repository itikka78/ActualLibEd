								end)
								if ok then
									library:notification({text = "Applied: " .. sel, time = 3})
								else
									library:notification({text = "Preset error: " .. tostring(err), time = 5})
								end
								return
							end
							local filename = sel:match("[^\\/]+$") or sel
							local path = fontPathMap[filename]
							if not path then
								library:notification({text = "Not found – hit Refresh first", time = 4})
								return
							end
							local ok, err = pcall(function()
								-- normalize backslashes from listfiles
