							-- SAME way Apply Font does (preset family or custom .ttf) and honours the saved
							-- Bold state. Anything missing/unresolvable (deleted preset, .ttf not on disk,
							-- getcustomasset failure) silently falls back to the Default font instead of
							-- erroring. Called from library:load_config.
							function library:apply_saved_font()
								fontBold = flags["lib_font_bold"] == true   -- sync Bold from the loaded config
								local sel = flags["lib_font_list"]
								if not sel or sel == "" then applyLibFont(defaultFont); return end
								if PRESET_FONTS[sel] then
									local ok, f = pcall(function()
										return type(PRESET_FONTS[sel]) == "function" and PRESET_FONTS[sel]() or PRESET_FONTS[sel]
									end)
									applyLibFont((ok and f) or defaultFont)   -- bad preset -> default
									return
								end
								local filename = sel:match("[^\\/]+$") or sel
								local path = fontPathMap[filename]
								if not path then applyLibFont(defaultFont); return end   -- not found -> default
								local ok, f = pcall(function()
									local norm_path = path:gsub("\\", "/")
									local ttf_asset = getcustomasset(norm_path)
									assert(ttf_asset and ttf_asset ~= "", "getcustomasset failed")
									local font_name = filename:gsub("%.[^%.]+$", "")
									local descriptor = http_service:JSONEncode({
										name = font_name,
										faces = {{ name = "Regular", weight = 400, style = "normal", assetId = ttf_asset }}
									})
									writefile("_atl_font.ttf", descriptor)
									local json_asset = getcustomasset("_atl_font.ttf")
									assert(json_asset and json_asset ~= "", "descriptor getcustomasset failed")
									return Font.new(json_asset, Enum.FontWeight.Regular)
								end)
								applyLibFont((ok and f) or defaultFont)   -- load error -> default
							end
						fontSec:button_holder({})
