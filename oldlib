						-- re-weight a font to Bold when the toggle is on (leaves it as-is otherwise)
						local function withBold(font)
							if not fontBold then return font end
							local ok, bf = pcall(function() return Font.new(font.Family, Enum.FontWeight.Bold, font.Style) end)
							return (ok and bf) or font
