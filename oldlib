			-- Console: a scrolling, timestamped log the script pushes lines into (see
			-- library:log). Each line is coloured by level so a wall of output still scans.
			function library:console(options)
				options = options or {}
				local cfg = {
					height = options.height or 200,
					max_lines = options.max_lines or 200,
					lines = {},
				}

				local LEVELS = {
					INFO    = rgb(90, 150, 255),
					WARN    = rgb(255, 200, 60),
					SUCCESS = rgb(90, 230, 120),
					ERROR   = rgb(255, 80, 80),
					DEBUG   = rgb(170, 170, 170),
				}

				-- outline -> inline -> gradient body, the same lining as embedded_box so it
				-- sits flush in a section
				local box = library:create("Frame", {
					Parent = self.holder,
					Name = "",
					Size = dim2(1, -8, 0, cfg.height),
					BorderSizePixel = 0,
					BorderColor3 = rgb(0, 0, 0),
					BackgroundColor3 = themes.preset.outline
				}) library:apply_theme(box, "outline", "BackgroundColor3")

				local inline = library:create("Frame", {
					Parent = box,
					Name = "",
					Position = dim2(0, 1, 0, 1),
					Size = dim2(1, -2, 1, -2),
					BorderSizePixel = 0,
					BorderColor3 = rgb(0, 0, 0),
					BackgroundColor3 = themes.preset.inline
				}) library:apply_theme(inline, "inline", "BackgroundColor3")

				local bg = library:create("Frame", {
					Parent = inline,
					Name = "",
					Position = dim2(0, 1, 0, 1),
					Size = dim2(1, -2, 1, -2),
					BorderSizePixel = 0,
					BorderColor3 = rgb(0, 0, 0),
					BackgroundColor3 = rgb(255, 255, 255)
				})

				local grad = library:create("UIGradient", {
					Parent = bg,
					Rotation = 90,
					Color = rgbseq{rgbkey(0, rgb(41, 41, 55)), rgbkey(1, rgb(35, 35, 47))}
				}) library:apply_theme(grad, "contrast", "Color")

				local sf = library:create("ScrollingFrame", {
					Parent = bg,
					Name = "",
					Active = true,
					BackgroundTransparency = 1,
					Size = dim2(1, 0, 1, 0),
					BorderSizePixel = 0,
					BorderColor3 = rgb(0, 0, 0),
					MidImage = "rbxassetid://103468666327206",
					TopImage = "rbxassetid://103468666327206",
					BottomImage = "rbxassetid://103468666327206",
					AutomaticCanvasSize = Enum.AutomaticSize.Y,
					CanvasSize = dim2(0, 0, 0, 0),
					ScrollBarThickness = 2,
					ScrollBarImageColor3 = themes.preset.accent,
					BackgroundColor3 = rgb(255, 255, 255)
				}) library:apply_theme(sf, "accent", "ScrollBarImageColor3")

				library:create("UIListLayout", {
					Parent = sf,
					Padding = dim(0, 2),
					SortOrder = Enum.SortOrder.LayoutOrder
				})

				library:create("UIPadding", {
					Parent = sf,
					PaddingTop = dim(0, 4),
					PaddingBottom = dim(0, 4),
					PaddingLeft = dim(0, 6),
					PaddingRight = dim(0, 4)
				})

				function cfg.add(text, level)
					level = string.upper(tostring(level or "INFO"))

					-- raw Instance.new, NOT library:create: create() registers every TextLabel
					-- into themes.utility and library.instances, and those lists are never
					-- pruned on Destroy. A console emitting thousands of lines would grow them
					-- forever and drag down every theme repaint. Line colour is per-level
					-- anyway, so there's nothing for the theme system to manage here.
					local line = Instance.new("TextLabel")
					line.FontFace = library.font
					line.TextColor3 = LEVELS[level] or LEVELS.INFO
					line.Text = string.format("[%s] [%s] %s", os.date("%H:%M:%S"), level, tostring(text))
					line.BackgroundTransparency = 1
					line.Size = dim2(1, -6, 0, 0)
					line.AutomaticSize = Enum.AutomaticSize.Y
					line.TextXAlignment = Enum.TextXAlignment.Left
					line.TextWrapped = true
					line.TextSize = 12
					line.BorderSizePixel = 0
					line.LayoutOrder = #cfg.lines + 1

					local stroke = Instance.new("UIStroke")
					stroke.Color = themes.preset.text_outline
					stroke.LineJoinMode = Enum.LineJoinMode.Miter
					stroke.Parent = line

					line.Parent = sf
					insert(cfg.lines, line)

					-- cap the history: without this a chatty script grows the GUI unbounded
					while #cfg.lines > cfg.max_lines do
						local old = remove(cfg.lines, 1)
						pcall(function() old:Destroy() end)
					end

					-- stick to the newest line. CanvasPosition clamps to the canvas, so an
					-- absurd Y just means "the bottom" without having to measure it.
					sf.CanvasPosition = vec2(0, 1e6)
					return line
				end

				function cfg.clear()
					for _, line in next, cfg.lines do
						pcall(function() line:Destroy() end)
					end
					cfg.lines = {}
				end

				cfg.holder = sf

				return setmetatable(cfg, library)
			end

