			function library:column(path) 
				local cfg = {}
				
				local holder = path or self.holder
				
				-- content-sized lane: Size Y is driven by the stacked sections (AutomaticSize.Y),
				-- so the parent section_holder ScrollingFrame can measure the tallest lane and
				-- scroll the whole page. A fixed scale-1 height here would pin every lane to the
				-- window and defeat both the page scroll and the content-sizing.
				local column = library:create("Frame", {
					Parent = holder,
					BackgroundTransparency = 1,
					Name = "\0",
					BorderColor3 = rgb(0, 0, 0),
					Size = dim2(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BorderSizePixel = 0,
					BackgroundColor3 = themes.preset.inline
				}) library:apply_theme(column, "inline", "BackgroundColor3")
				
				-- sections size to their own content (AutomaticSize.Y) and stack from the top,
				-- so a short lane leaves empty space at the BOTTOM instead of flex-stretching its
				-- sections to fill the column (which left the gap inside a lone short section).
				library:create("UIListLayout", {
					Parent = column,
					Padding = dim(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder
				})
				
				cfg["holder"] = column

				-- Lane-aware minimum width. Columns are the page's vertical "lanes"; the tab's
				-- section_holder splits them evenly (HorizontalFlex = Fill). Two lanes fit the
				-- stock 604px window, but a page built with 3+ lanes needs a wider window or the
				-- extra lane squeezes elements into clipping. We count lanes per tab (self is the
				-- tab), and once a tab passes 2 lanes we raise the main window's resize floor and,
				-- if it's currently narrower, grow it to fit. Each lane past 2 adds 122px, matching
				-- the comfortable ~726px 3-lane spacing. Panels/tabs with 1-2 lanes are untouched.
				self._lane_count = (self._lane_count or 0) + 1
				if self._lane_count >= 3 and library._main_holder then
					local mh = library._main_holder
					local want = 604 + (self._lane_count - 2) * 122
					library.min_widths = library.min_widths or {}
					if (library.min_widths[mh] or 0) < want then
						library.min_widths[mh] = want
					end
					if mh.Size.X.Offset < want then
						mh.Size = dim2(mh.Size.X.Scale, want, mh.Size.Y.Scale, mh.Size.Y.Offset)
					end
				end

				return setmetatable(cfg, library)
			end

