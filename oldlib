					-- horizontal bar (top/bottom) grows left->right; vertical (left/right) grows bottom->up
					if cfg._bar_horiz and cfg._bar_horiz.healthbar then
						objects[ "healthbar" ].Size = UDim2.new(multiplier, -2, 1, -2)
						objects[ "healthbar" ].Position = UDim2.new(0, 1, 0, 1)
					else
						objects[ "healthbar" ].Size = UDim2.new(1, -2, multiplier, -2)
						objects[ "healthbar" ].Position = UDim2.new(0, 1, 1 - multiplier, 1)
					end
					objects[ "healthbar" ].BackgroundColor3 = color

					-- HP number mirrors the animated health value
					objects[ "hp_number" ].Text = tostring(math.floor(multiplier * humanoid.MaxHealth + 0.5))
				end -- wtf why diff func defining

				function cfg.refresh_elements( )                                
					objects.holder.Parent = flags["Enabled"] and items.viewportframe or library.cache

					-- Healthbar + Ammo are builder-owned globals now (gated by cfg._show below),
					-- so they're NOT in this flag-driven temp loop — otherwise the real ESP flags
					-- would auto-show them on the preview regardless of the tray.
					local temp = {
						["Names"] = objects["name"];
						["Name_Color"] = {objects["name"]};
						["Distance"] = objects[ "distance" ];
						["Weapon"] = objects[ "weapon" ];
						["Distance_Color"] = {objects[ "distance" ]};
						["Weapon_Color"] = {objects[ "weapon" ]};
						["HP_Text"] = objects[ "hp_number" ];
						["HP_Text_Color"] = {objects[ "hp_number" ]};
						["ESP_KD"] = objects[ "kd" ];
						["ESP_KD_Color"] = {objects[ "kd" ]};
					}

					for flag,object in temp do
						if flags[flag] ~= nil then
							if type(object) == "table" then
								object[1].TextColor3 = flags[flag].Color
							elseif cfg._chip_set and cfg._chip_set[object] then
								-- builder owns chip placement/visibility; refresh only recolours it
							else
								object.Parent = flags[flag] and objects[ "holder" ] or library.cache
							end
						end
					end
					
					local is_corner = flags[ "Box_Type" ] == "Corner"

					-- Box visibility: the ESP builder owns it via cfg._show.box (a global chip);
					-- fall back to the real Boxes flag when the builder isn't up.
					local box_on
					if cfg._show then box_on = cfg._show.box == true else box_on = flags["Boxes"] == true end

					if box_on then
						if is_corner then 
							objects[ "corners" ].Parent = objects["holder"]
							objects[ "box_handler" ].Parent = library.cache
							objects[ "box_outline" ].Parent = library.cache
						else 
							objects[ "box_handler" ].Parent = objects[ "holder" ]
							objects[ "box_outline" ].Parent = objects[ "holder" ]
							objects[ "corners" ].Parent = library.cache
						end 
					else
						objects[ "corners" ].Parent =  library.cache
						objects[ "box_handler" ].Parent = library.cache
						objects[ "box_outline" ].Parent = library.cache
					end 

					objects[ "box_color" ].Color = flags["Box_Color"].Color 

					for _, corner in objects[ "corners" ]:GetChildren() do
						corner.Frame.BackgroundColor3 = flags["Box_Color"].Color
					end

					-- Healthbar: builder-owned via cfg._show.healthbar (a global chip); fall back
					-- to the real Healthbar flag only when the builder never wired up.
					do
						local hp_on
						if cfg._show then hp_on = cfg._show.healthbar == true else hp_on = flags["Healthbar"] == true end
						objects["healthbar_holder"].Parent = hp_on and objects["holder"] or library.cache
					end

					-- Edition tag (gated by ESP_Edition; colour from the Elite picker)
					if objects["edition"] then
						-- builder owns placement/visibility; refresh only recolours it
						local ec = flags["ESP_Edition_Elite"]
						if ec and ec.Color then objects["edition"].TextColor3 = ec.Color end
					end

					-- Status tags: driven by the ESP_Status_Sel multiselect, each with its colour
					do
						local sel = flags["ESP_Status_Sel"]
						local set = {}
						if type(sel) == "table" then for _, v in ipairs(sel) do set[v] = true end
						elseif type(sel) == "string" then set[sel] = true end
						local status_map = {
							{"vis",     "Visible", "ESP_Vis_Color"},
							{"manip",   "Manip",   "ESP_Manip_Color"},
							{"reload",  "Reload",  "ESP_Reload_Color"},
							{"exiting", "Exiting", "ESP_Exit_Color"},
							{"combat",  "Combat",  "ESP_Combat_Color"},
							{"looting", "Looting", "ESP_Loot_Color"},
						}
						for _, s in ipairs(status_map) do
							local obj = objects[s[1]]
							if obj then
								-- builder owns placement/visibility; refresh only recolours it
								local c = flags[s[3]]
								if c and c.Color then obj.TextColor3 = c.Color end
							end
						end
					end

					-- Ammo bar: builder-owned via cfg._show.ammo (a global chip); fall back to the
					-- real Ammobar flag only when the builder never wired up.
					if objects["ammo_bg"] then
						local ammo_on
						if cfg._show then ammo_on = cfg._show.ammo == true else ammo_on = flags["Ammobar"] == true end
						objects["ammo_bg"].Parent = ammo_on and objects["holder"] or library.cache
						local bg = flags["Ammo_BG_Color"]
						if bg and bg.Color then objects["ammo_bg"].BackgroundColor3 = bg.Color end
						local c1, c2 = flags["Ammo_Color_Top"], flags["Ammo_Color_Bottom"]
						if objects["ammo_grad"] and c1 and c2 and c1.Color and c2.Color then
							objects["ammo_grad"].Color = ColorSequence.new(c1.Color, c2.Color)
						end
					end
				end

				task.spawn(function()
					local sg
					while true do
						task.wait()
						-- only animate the preview health while the ESP-preview panel is on-screen
						-- (menu open). Resolve+cache the panel ScreenGui once, then gate on Enabled.
						if not sg then sg = items.viewportframe and items.viewportframe:FindFirstAncestorWhichIsA("ScreenGui") end
						if (not sg) or sg.Enabled then cfg.change_health() end
					end
				end)

				-- Re-clone the showcase character every 5s while the menu is on-screen, so
				-- it reflects the local player's current appearance/gear. Only runs when the
				-- preview's ScreenGui is enabled (menu open) to avoid needless work.
				task.spawn(function()
					while true do
						task.wait(5)
						local sg = items.viewportframe and items.viewportframe:FindFirstAncestorWhichIsA("ScreenGui")
						if sg and sg.Enabled and lp.Character then
							pcall(function()
								lp.Character.Archivable = true
								local fresh = lp.Character:Clone()
								local anim = fresh:FindFirstChild("Animate")
								if anim then anim:Destroy() end
								local old = character
								character = fresh
								character.Parent = items.viewportframe
								items.camera.CameraSubject = character
								if old then old:Destroy() end
							end)
						end
					end
				end)

				-- ── ESP LAYOUT BUILDER (v1) ──────────────────────────────────────────────
				-- Drag the element chips onto the box's four sides. Each side is a UIListLayout
				-- stack so order is real — drop a chip between two others to insert it there, and
				-- top/bottom grow up/down while left/right stack beside the box. The bottom tray
				-- holds un-placed chips; drop a placed chip back on the tray to remove it. Side +
				-- insertion pick use Roblox's native hover (drop-zones / chip MouseEnter), so there
				-- is no inset/absolute-position math. Layout persists in the esp_layout flag. The
				-- whole thing is pcall-wrapped: a builder hiccup can never abort the menu load.
				-- The error is captured + logged (Output console + warn) so a silent failure —
				-- which would leave the tabs/tray/chips unbuilt — is diagnosable, not invisible.
				local _esp_ok, _esp_err = pcall(function()
					local objects  = cfg.objects
					local holder   = objects.holder
					local ACCENT   = (themes and themes.preset and themes.preset.accent) or rgb(225, 55, 110)
					local TXT      = (themes and themes.preset and themes.preset.text)   or rgb(220, 220, 220)

					-- placeable text elements (real preview objects) + their palette label
					local CHIPS = {
						{key = "name",      label = "Name"},
						{key = "distance",  label = "Distance"},
						{key = "weapon",    label = "Weapon"},
						{key = "hp_number", label = "HP"},
						{key = "kd",        label = "KD"},
						{key = "edition",   label = "Edition"},
						{key = "vis",       label = "Visible"},
						{key = "manip",     label = "Manip"},
						{key = "reload",    label = "Reload"},
						{key = "exiting",   label = "Exiting"},
						{key = "combat",    label = "Combat"},
						{key = "looting",   label = "Looting"},
						{key = "stats",     label = "Stats"},
							{key = "ammo_counter", label = "Ammo Count"},
						-- global toggle chips: whole-preview visuals, NOT side-anchored. Drag out
						-- of the tray to turn ON, drag back to the tray to turn OFF.
						{key = "box",       label = "Box",       global = true},
						{key = "skeleton",  label = "Skeleton",  global = true},
						{key = "chams",     label = "Chams",     global = true},
						{key = "head_dot",  label = "Head Dot",  global = true},
						{key = "healthbar", label = "Healthbar", bar = true},
						{key = "ammo",      label = "Ammo Bar",  bar = true},
					}
					-- nothing placed by default: every chip (text tags AND the box/skeleton/chams/
					-- head_dot globals) starts in the tray, so the box is empty until you drag/click
					local DEFAULT_SIDE = {}
					local SIDES = {"top", "bottom", "left", "right"}

					-- global toggle chips have no side — they just enable/disable a whole-preview
					-- visual. cfg._show is the live on/off state the preview overlay + refresh read.
					local GLOBAL_KEYS = {}
					for _, c in ipairs(CHIPS) do if c.global then GLOBAL_KEYS[c.key] = true end end
					-- BAR chips (healthbar / ammo): draggable to a side like a side chip, but they
					-- render as a bar whose orientation follows the side (top/bottom = horizontal,
					-- left/right = vertical) instead of stacking in a UIListLayout container.
					local BAR_KEYS = {}
					for _, c in ipairs(CHIPS) do if c.bar then BAR_KEYS[c.key] = true end end
					local LABELS = {}   -- key -> label, for the drag ghost when picking a placed element up
					for _, c in ipairs(CHIPS) do LABELS[c.key] = c.label end
					-- global chip -> the real ESP flag it mirrors, so a fresh builder (no saved
					-- layout) starts each global ON if its ESP toggle is already on.
					local GLOBAL_FLAG = { box = "Boxes", skeleton = "Skeleton", chams = "Chams", head_dot = "HeadDot", healthbar = "Healthbar", ammo = "Ammobar" }
					cfg._show = {}
					for k in pairs(GLOBAL_KEYS) do cfg._show[k] = false end
					for k in pairs(BAR_KEYS)    do cfg._show[k] = false end

					-- so refresh_elements switches the temp-loop chips (name/distance/weapon/hp/kd)
					-- to visibility instead of reparenting them out of their side container
					cfg._chip_set = {}
					for _, k in ipairs({"name", "distance", "weapon", "hp_number", "kd"}) do
						if objects[k] then cfg._chip_set[objects[k]] = true end
					end

					-- 4 side containers, each a UIListLayout stack hugging one edge of the box
					local containers = {}
					local function make_side(anchor, pos, halign, valign)
						local c = library:create("Frame", {
							Parent = holder; Name = "\0"; BackgroundTransparency = 1; BorderSizePixel = 0;
							AnchorPoint = anchor; Position = pos; Size = dim2(0, 0, 0, 0);
							AutomaticSize = Enum.AutomaticSize.XY; ZIndex = 3;
						})
						library:create("UIListLayout", {
							Parent = c; FillDirection = Enum.FillDirection.Vertical;
							HorizontalAlignment = halign; VerticalAlignment = valign;
							SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 1);
						})
						return c
					end
					containers.top    = make_side(vec2(0.5, 1), dim2(0.5, 0, 0, -3), Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
					containers.bottom = make_side(vec2(0.5, 0), dim2(0.5, 0, 1, 3),  Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
					-- left/right hug the box's TOP corners and stack DOWNWARD (NHack-style), so
					-- side tags read from the top of the side instead of centered on the box.
					containers.left   = make_side(vec2(1, 0), dim2(0, -5, 0, 0), Enum.HorizontalAlignment.Right,  Enum.VerticalAlignment.Top)
					containers.right  = make_side(vec2(0, 0), dim2(1, 5, 0, 0),  Enum.HorizontalAlignment.Left,   Enum.VerticalAlignment.Top)

					-- normalize a real element so a UIListLayout can own its position, and give it a
					-- faint rounded backing used for the hover glow (invisible until hovered)
					local function normalize(o)
						o.AnchorPoint = vec2(0, 0)
						o.Size = dim2(0, 0, 0, 0)
						o.AutomaticSize = Enum.AutomaticSize.XY
						o.TextXAlignment = Enum.TextXAlignment.Center
						o.Active = true
						o.BackgroundColor3 = ACCENT
						o.BackgroundTransparency = 1
						if not o:FindFirstChildOfClass("UICorner") then
							library:create("UICorner", {Parent = o; CornerRadius = dim(0, 3)})
						end
						if not o:FindFirstChildOfClass("UIPadding") then
							library:create("UIPadding", {Parent = o;
								PaddingLeft = dim(0, 3); PaddingRight = dim(0, 3)})
						end
					end

					-- BAR positioning: place a bar's outer frame on the chosen edge and record its
					-- orientation in cfg._bar_horiz, which change_health (health fill) and
					-- update_preview_overlays (ammo fill) read to grow the fill the right way. The
					-- Position/Size set here persist on the instance even while it's parked in
					-- library.cache (off), so refresh_elements only has to toggle its Parent.
					local DEFAULT_BAR_SIDE = { healthbar = "left", ammo = "bottom" }
					cfg._bar_horiz = cfg._bar_horiz or {}
					local BAR_ORDER = { "healthbar", "ammo" }   -- stable slot order on a shared side
					local function bar_outer(key)
						return (key == "healthbar") and objects.healthbar_holder or objects.ammo_bg
					end
					-- Lay out EVERY bar currently on `side`, splitting the edge so two bars sit
					-- side-by-side (like two tags in a row) instead of stacking on top of each
					-- other. Horizontal sides (top/bottom) split the WIDTH; vertical sides
					-- (left/right) split the HEIGHT. One bar on the side = fills the whole edge.
					local placed   -- forward ref (declared just below); read by the layout fn
					local function layout_bars_on_side(side)
						if not side then return end
						local horiz = (side == "top" or side == "bottom")
						local list = {}
						for _, k in ipairs(BAR_ORDER) do if placed[k] == side then list[#list + 1] = k end end
						local n = #list
						if n == 0 then return end
						for i, key in ipairs(list) do
							local outer = bar_outer(key)
							if outer then
								cfg._bar_horiz[key] = horiz
								-- thickness reads the real ESP stat live: healthbar = hp_bar_width,
								-- ammo = ammo_bar_width (both 1..8, default 3). +1 keeps the default
								-- looking like the old fixed 4px bar.
								local wf = (key == "healthbar") and "hp_bar_width" or "ammo_bar_width"
								local T = math.clamp(tonumber(flags[wf]) or 3, 1, 8) + 1
								local frac = 1 / n
								local off  = (i - 1) * frac
								if horiz then
									-- split WIDTH: bars packed along the top/bottom edge, 2px gutter
									local ay = (side == "top") and 1 or 0
									local oy = (side == "top") and -5 or 5
									local py = (side == "top") and 0 or 1
									outer.AnchorPoint = vec2(0, ay)
									outer.Position    = dim2(off, 1, py, oy)
									outer.Size        = dim2(frac, -2, 0, T)
								else
									-- split HEIGHT: bars packed along the left/right edge, 2px gutter
									local ax = (side == "left") and 1 or 0
									local ox = (side == "left") and -5 or 5
									local px = (side == "left") and 0 or 1
									outer.AnchorPoint = vec2(ax, 0)
									outer.Position    = dim2(px, ox, off, 1)
									outer.Size        = dim2(0, T, frac, -2)
								end
								-- ammo fill has a gradient; rotate it to run along the bar
								if key == "ammo" and objects.ammo_grad then objects.ammo_grad.Rotation = horiz and 0 or 90 end
							end
						end
					end
					-- kept as the single-key entry point (apply_from_string / callers): position
					-- `key` on `side` by re-laying every bar sharing that side.
					local function apply_bar(key, side)
						layout_bars_on_side(side)
					end

					-- state
					placed = {}   -- key -> side (nil = in palette)
					local order  = {}   -- key -> layout order within its side

					-- Side stacks normally hug the box edge; a bar on that edge would sit UNDER the
					-- text tags. So when a bar occupies a side, push that side's container outward past
					-- the bar's footprint (SIDE_PUSH), and restore SIDE_BASE when the bar leaves.
					local SIDE_BASE = {
						top    = dim2(0.5, 0, 0, -3), bottom = dim2(0.5, 0, 1, 3),
						left   = dim2(0, -5, 0, 0),   right  = dim2(1, 5, 0, 0),
					}
					local SIDE_PUSH = {
						top    = dim2(0.5, 0, 0, -11), bottom = dim2(0.5, 0, 1, 11),
						left   = dim2(0, -11, 0, 0),   right  = dim2(1, 11, 0, 0),
					}
					local function refresh_side_offsets()
						for _, s in ipairs({"top", "bottom", "left", "right"}) do
							if containers[s] then
								local barHere = (placed.healthbar == s) or (placed.ammo == s)
								containers[s].Position = barHere and SIDE_PUSH[s] or SIDE_BASE[s]
							end
						end
					end

					-- palette tray: a visually SEPARATE box below the preview — its own bordered
					-- dark panel with a top accent line + label, holding the wrapping row of
					-- un-placed chips. LayoutOrder 50 stacks it under the viewport(0) in the
					-- section's vertical layout, so it's obviously distinct from the ESP draw area.
					local tray_wrap = library:create("Frame", {
						Parent = self.holder; Name = "\0"; Active = true; LayoutOrder = 50;
						Size = dim2(1, -8, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
						BackgroundColor3 = themes.preset.high_contrast; BorderSizePixel = 0; ZIndex = 5;
					}) library:apply_theme(tray_wrap, "high_contrast", "BackgroundColor3")
					do
						local st = library:create("UIStroke", {
							Parent = tray_wrap; Color = themes.preset.inline; Thickness = 1;
							LineJoinMode = Enum.LineJoinMode.Miter;
						}) library:apply_theme(st, "inline", "Color")
					end
					library:create("UIListLayout", {
						Parent = tray_wrap; FillDirection = Enum.FillDirection.Vertical;
						SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 4);
					})
					library:create("UIPadding", {
						Parent = tray_wrap; PaddingTop = dim(0, 5); PaddingBottom = dim(0, 7);
						PaddingLeft = dim(0, 6); PaddingRight = dim(0, 6);
					})
					local tray_accent = library:create("Frame", {
						Parent = tray_wrap; Name = "\0"; LayoutOrder = 0;
						Size = dim2(1, 0, 0, 2); BackgroundColor3 = themes.preset.accent;
						BorderSizePixel = 0; ZIndex = 6;
					}) library:apply_theme(tray_accent, "accent", "BackgroundColor3")
					local tray_label = library:create("TextLabel", {
						Parent = tray_wrap; Name = "\0"; LayoutOrder = 1; FontFace = library.font;
						Text = "UNPLACED  \u{2014}  drag onto the box"; TextSize = 12; TextColor3 = themes.preset.text;
						BackgroundTransparency = 1; BorderSizePixel = 0; Size = dim2(1, 0, 0, 12);
						TextXAlignment = Enum.TextXAlignment.Left;
					}) library:apply_theme(tray_label, "text", "TextColor3")
					local tray = library:create("Frame", {
						Parent = tray_wrap; Name = "\0"; LayoutOrder = 2; Active = true;
						Size = dim2(1, 0, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
						BackgroundTransparency = 1; BorderSizePixel = 0; ZIndex = 5;
					})
					local tray_layout = library:create("UIListLayout", {
						Parent = tray; FillDirection = Enum.FillDirection.Horizontal;
						HorizontalAlignment = Enum.HorizontalAlignment.Left;
						VerticalAlignment = Enum.VerticalAlignment.Top;
						SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 6);
					})
					pcall(function() tray_layout.Wraps = true end)   -- newer prop; skip on old builds
					local palette_chips = {}
					local chip_active   = {}   -- chip -> bool: global chips keep a faint accent fill while ON

					-- drag state, driven entirely by native hover (no absolute/inset math)
					local dragging, hover_side, hover_before, hover_palette = nil, nil, nil, false
					local last_hpw, last_ammow   -- last-seen bar thickness stats (live re-pack)

					-- Drag ghost: a floating clone of the chip that follows the cursor while dragging,
					-- so it reads as "picking up" the element instead of teleporting on drop. Lives on
					-- the shared sgui (IgnoreGuiInset), so its Y adds gui_offset to sit at the cursor.
					local drag_ghost = nil
					local function make_drag_ghost(label)
						if drag_ghost then pcall(function() drag_ghost:Destroy() end) end
						drag_ghost = library:create("TextLabel", {
							Parent = sgui; Name = "\0"; FontFace = library.font; Active = false;
							Text = label or ""; TextColor3 = TXT; BackgroundColor3 = ACCENT;
							BackgroundTransparency = 0.3; BorderSizePixel = 0; ZIndex = 9999;
							AutomaticSize = Enum.AutomaticSize.X; Size = dim2(0, 0, 0, 16); TextSize = 12;
							TextXAlignment = Enum.TextXAlignment.Center;
						})
						library:create("UICorner", {Parent = drag_ghost; CornerRadius = dim(0, 3)})
						library:create("UIPadding", {Parent = drag_ghost; PaddingLeft = dim(0, 5); PaddingRight = dim(0, 5)})
						library:create("UIStroke", {Parent = drag_ghost; Color = ACCENT; Thickness = 1; LineJoinMode = Enum.LineJoinMode.Miter})
					end
					local function kill_drag_ghost()
						if drag_ghost then pcall(function() drag_ghost:Destroy() end); drag_ghost = nil end
					end

					-- MAIN vs AI tab: the same chips/preview edit two independent layouts, saved to
					-- esp_layout (players) and esp_layout_ai (AI). The tab bar (built below) flips it.
					local layout_ctx = "player"
					local function lflag() return layout_ctx == "ai" and "esp_layout_ai" or "esp_layout" end

					local function relayout(side)
						local list = {}
						for k, s in pairs(placed) do if s == side then list[#list + 1] = k end end
						table.sort(list, function(a, b) return (order[a] or 0) < (order[b] or 0) end)
						for i, k in ipairs(list) do order[k] = i; objects[k].LayoutOrder = i end
					end

					local function save_layout()
						local parts = {}
						for _, c in ipairs(CHIPS) do
							local s = placed[c.key]
							if s then parts[#parts + 1] = c.key .. ":" .. s .. ":" .. (order[c.key] or 1) end
						end
						flags[lflag()] = table.concat(parts, ",")   -- into the active tab's flag
					end

					local function refresh_palette()
						for _, c in ipairs(CHIPS) do
							local chip = palette_chips[c.key]
							if chip then
								if GLOBAL_KEYS[c.key] or BAR_KEYS[c.key] then
									-- globals/bars live in the tray permanently and show a faint accent
									-- fill while ON — the tray doubles as their on/off state (a global has
									-- nothing to drag onto the box; a bar's placement lives on the box).
									chip.Visible = true
									chip_active[chip] = placed[c.key] ~= nil
									chip.BackgroundTransparency = chip_active[chip] and 0.35 or 1
								else
									chip.Visible = placed[c.key] == nil
								end
							end
						end
					end

					-- APPLY = ON: placing a feature drives the REAL ESP flag (not just the preview),
					-- so drag-to-apply replaces the old on/off toggle. ctx-aware: the AI tab writes
					-- the AI_ flag (AI_F[k] == "AI_"..PLAYER_F[k]). Statuses (manip/reload/… go through
					-- a multiselect) have no simple boolean, so they're preview-only for now.
					local REAL_FLAG = {
						box = "Boxes", skeleton = "Skeleton", chams = "Chams", head_dot = "HeadDot",
						healthbar = "Healthbar", ammo = "Ammobar",
						name = "Names", distance = "Distance", weapon = "Weapon",
						hp_number = "HP_Text", kd = "ESP_KD", edition = "ESP_Edition", ammo_counter = "Ammo_Counter",
					}
					-- status chips (vis/manip/reload/exiting/combat/looting) aren't booleans — they
					-- drive the ESP_Status_Sel MULTISELECT the renderer reads. Placing one adds its
					-- name to that array; unplacing removes it. ctx-aware (AI_ESP_Status_Sel on AI).
					local STATUS_MAP = { vis = "Visible", manip = "Manip", reload = "Reload",
						exiting = "Exiting", combat = "Combat", looting = "Looting" }
					local function sync_status(key, on)
						local name = STATUS_MAP[key]
						if not name then return end
						local fl = (layout_ctx == "ai") and "AI_ESP_Status_Sel" or "ESP_Status_Sel"
						local arr = flags[fl]; if type(arr) ~= "table" then arr = {} end
						local out = {}
						for _, v in ipairs(arr) do if v ~= name then out[#out + 1] = v end end   -- drop existing
						if on then out[#out + 1] = name end
						flags[fl] = out
						if properties.on_apply then pcall(properties.on_apply, key, on, layout_ctx) end
					end
					local function sync_real_flag(key, on)
						local fl = REAL_FLAG[key]
						if fl then
							if layout_ctx == "ai" then fl = "AI_" .. fl end
							flags[fl] = on and true or false
							if properties.on_apply then pcall(properties.on_apply, key, on, layout_ctx) end
						else
							sync_status(key, on)   -- not a boolean flag → maybe a status chip
						end
					end

					local function place(key, side, before_key)
						if BAR_KEYS[key] then
							local old = placed[key]
							side = side or DEFAULT_BAR_SIDE[key] or "bottom"
							placed[key] = side; cfg._show[key] = true
							layout_bars_on_side(side)
							if old and old ~= side then layout_bars_on_side(old) end   -- re-pack the side it left
							refresh_side_offsets()
							refresh_palette(); save_layout(); sync_real_flag(key, true)
							if cfg.refresh_elements then pcall(cfg.refresh_elements) end
							return
						end
						if GLOBAL_KEYS[key] then
							placed[key] = "on"; cfg._show[key] = true
							refresh_palette(); save_layout(); sync_real_flag(key, true)
							-- box/healthbar/ammo are shown via refresh_elements (parenting), not the
							-- per-frame overlay, so re-run it on any global toggle to reflect instantly
							if cfg.refresh_elements then pcall(cfg.refresh_elements) end
							return
						end
						objects[key].Parent = containers[side]
						placed[key] = side
						sync_real_flag(key, true)
						if before_key and placed[before_key] == side then
							order[key] = (order[before_key] or 1) - 0.5   -- land just before it
						else
							local mx = 0
							for k, s in pairs(placed) do if s == side and k ~= key then mx = math.max(mx, order[k] or 0) end end
							order[key] = mx + 1
						end
						relayout(side)
						refresh_palette()
						save_layout()
						-- little pop for drop feedback (doesn't fight the layout)
						objects[key].BackgroundTransparency = 0.6
						tween_service:Create(objects[key], TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
					end

					local function unplace(key)
						if BAR_KEYS[key] then
							local old = placed[key]
							placed[key] = nil; cfg._show[key] = false
							if old then layout_bars_on_side(old) end   -- re-pack the remaining bar to full edge
							refresh_side_offsets()
							refresh_palette(); save_layout(); sync_real_flag(key, false)
							if cfg.refresh_elements then pcall(cfg.refresh_elements) end
							return
						end
						if GLOBAL_KEYS[key] then
							placed[key] = nil; cfg._show[key] = false
							refresh_palette(); save_layout(); sync_real_flag(key, false)
							if cfg.refresh_elements then pcall(cfg.refresh_elements) end
							return
						end
						local side = placed[key]
						objects[key].Parent = library.cache
						placed[key] = nil; order[key] = nil
						if side then relayout(side) end
						refresh_palette()
						save_layout()
						sync_real_flag(key, false)
					end

					local function add_hover(o)
						library:connection(o.MouseEnter, function()
							if dragging then return end
							tween_service:Create(o, TweenInfo.new(0.12), {BackgroundTransparency = 0.6}):Play()
						end)
						library:connection(o.MouseLeave, function()
							-- on-globals keep a faint fill (chip_active); everything else clears fully
							local rest = chip_active[o] and 0.35 or 1
							tween_service:Create(o, TweenInfo.new(0.12), {BackgroundTransparency = rest}):Play()
						end)
					end

					local function bind_drag(src, key, label)
						library:connection(src.InputBegan, function(input)
							if input.UserInputType == Enum.UserInputType.MouseButton1
								or input.UserInputType == Enum.UserInputType.Touch then
								dragging = key; hover_side = nil; hover_before = nil; hover_palette = false
								make_drag_ghost(label)
							end
						end)
					end

					-- side drop zones: invisible frames that report which side the cursor is over
					local function make_zone(anchor, pos, size, side)
						local z = library:create("Frame", {
							Parent = holder; Name = "\0"; BackgroundTransparency = 1; Active = true;
							AnchorPoint = anchor; Position = pos; Size = size; BorderSizePixel = 0; ZIndex = 2;
						})
						library:connection(z.MouseEnter, function() if dragging then hover_side = side; hover_before = nil end end)
						library:connection(z.MouseLeave, function() if dragging and hover_side == side then hover_side = nil end end)
					end
					make_zone(vec2(0.5, 1), dim2(0.5, 0, 0, 0), dim2(2, 24, 0, 55), "top")
					make_zone(vec2(0.5, 0), dim2(0.5, 0, 1, 0), dim2(2, 24, 0, 55), "bottom")
					make_zone(vec2(1, 0.5), dim2(0, 0, 0.5, 0), dim2(0, 55, 2, 24), "left")
					make_zone(vec2(0, 0.5), dim2(1, 0, 0.5, 0), dim2(0, 55, 2, 24), "right")

					-- tray box = drop-to-remove zone (the whole bordered panel, not just the chips)
					library:connection(tray_wrap.MouseEnter, function() if dragging then hover_palette = true end end)
					library:connection(tray_wrap.MouseLeave, function() hover_palette = false end)

					-- global release commits the drag
					library:connection(uis.InputEnded, function(input)
						if not dragging then return end
						if input.UserInputType ~= Enum.UserInputType.MouseButton1
							and input.UserInputType ~= Enum.UserInputType.Touch then return end
						local key = dragging; dragging = nil
						if BAR_KEYS[key] then
							-- DRAG-ONLY (no click-to-apply): dropping over the box enables/moves the
							-- bar (a side zone picks the edge; the box centre uses the default side);
							-- dropping back on the tray removes it. A click that never left the tray
							-- does nothing. hover_palette only fires on ENTER, so test the tray here.
							if library:hovering(tray_wrap) then
								if placed[key] then unplace(key) end       -- drag back to tray removes
							elseif hover_side then place(key, hover_side)  -- dropped on an edge
							else place(key) end                            -- dropped on the box centre → default side
						elseif GLOBAL_KEYS[key] then
							-- DRAG-ONLY: drag onto the box to enable, drag back to the tray to remove.
							-- A plain click in the tray no longer toggles it on.
							if library:hovering(tray_wrap) then
								if placed[key] then unplace(key) end       -- drag back to tray removes
							else
								place(key)                                 -- dropped anywhere on the box → ON
							end
						elseif hover_palette then unplace(key)
						elseif hover_side then place(key, hover_side, hover_before) end
						hover_side = nil; hover_before = nil; hover_palette = false
						kill_drag_ghost()
					end)

					-- wire each real element as a drag source + build its palette chip. Each chip
					-- is pcall-isolated so one bad element can NEVER abort the loop (which would
					-- leave the tray/tabs unbuilt); a failure is logged with the chip's key.
					for _, c in ipairs(CHIPS) do
						local okc, errc = pcall(function()
							local o = objects[c.key]
							-- side chips wire the real preview element as a drag source too. Global
							-- chips (box/skeleton/chams/head_dot/healthbar/ammo) have no draggable
							-- side element, so only the tray chip drives them and the preview reads
							-- cfg._show for their on/off state.
							if o and not GLOBAL_KEYS[c.key] and not BAR_KEYS[c.key] then
								normalize(o)
								add_hover(o)
								bind_drag(o, c.key, c.label)
								-- during a drag, hovering a placed chip = insert before it
								library:connection(o.MouseEnter, function()
									if dragging and dragging ~= c.key and placed[c.key] then
										hover_side = placed[c.key]; hover_before = c.key
									end
								end)
							end

							-- every element gets a tray chip (the drag source)
							local chip = library:create("TextLabel", {
								Parent = tray; Name = "\0"; Active = true; FontFace = library.font;
								Text = c.label; TextColor3 = TXT; BackgroundColor3 = ACCENT;
								BackgroundTransparency = 1; BorderSizePixel = 0;
								AutomaticSize = Enum.AutomaticSize.X; Size = dim2(0, 0, 0, 14); TextSize = 12; ZIndex = 6;
							})
							library:create("UICorner", {Parent = chip; CornerRadius = dim(0, 3)})
							library:create("UIPadding", {Parent = chip; PaddingLeft = dim(0, 4); PaddingRight = dim(0, 4)})
							palette_chips[c.key] = chip
							add_hover(chip)
							bind_drag(chip, c.key, c.label)
						end)
						if not okc then
							warn("[ESP chip " .. tostring(c.key) .. "] " .. tostring(errc))
							pcall(function() library:log("ESP chip '" .. tostring(c.key) .. "' failed: " .. tostring(errc), "ERROR") end)
						end
					end

					-- ── HOVER SELECTION ("selection cube") + drag-ghost mover ──────────────────
					-- The drawn visuals (box / skeleton / chams / head dot / healthbar / ammo) keep
					-- drawing; hovering one pops an accent selection outline around it and records
					-- cfg._selected_key. Right-click over a selection calls cfg.on_element_rightclick
					-- (nil for now — that's the hook the future options menu wires into). ONE shared
					-- overlay, snapped to the hovered element via its AbsolutePosition so it works
					-- across the different parents / coord-spaces the visuals live in.
					local sel_overlay = library:create("Frame", {
						Parent = items.viewportframe; Name = "\0"; Visible = false;
						BackgroundTransparency = 1; BorderSizePixel = 0; ZIndex = 9;
					})
					library:create("UIStroke", {Parent = sel_overlay; Color = ACCENT; Thickness = 1.5; LineJoinMode = Enum.LineJoinMode.Miter})
					library:create("UICorner", {Parent = sel_overlay; CornerRadius = dim(0, 3)})

					-- topmost drawn element under the cursor (small visuals win over the whole box)
					local function pick_hover()
						local o = objects
						if o.head_dot and o.head_dot.Visible and library:hovering(o.head_dot) then return o.head_dot, "head_dot" end
						if o.chams_box and o.chams_box.Visible and library:hovering(o.chams_box) then return o.chams_box, "chams" end
						if o.skel_box and o.skel_box.Visible and library:hovering(o.skel_box) then return o.skel_box, "skeleton" end
						if o.ammo_bg and o.ammo_bg.Parent == o.holder and library:hovering(o.ammo_bg) then return o.ammo_bg, "ammo" end
						if o.healthbar_holder and o.healthbar_holder.Parent == o.holder and library:hovering(o.healthbar_holder) then return o.healthbar_holder, "healthbar" end
						-- placed TEXT tags (name/distance/weapon/hp/kd/edition + the status
						-- indicators + ammo counter): each is objects[key] living in a side
						-- container, so hovering one selects that key. Checked BEFORE the box so a
						-- tag overlapping the box edge still wins — this is what makes them
						-- right-clickable (open their settings panel) like the box/bar visuals.
						for key, side in pairs(placed) do
							if not GLOBAL_KEYS[key] and not BAR_KEYS[key] then
								local el = objects[key]
								if el and el.Visible and library:hovering(el) then return el, key end
							end
						end
						if cfg._show and cfg._show.box and o.holder and library:hovering(o.holder) then return o.holder, "box" end
						return nil
					end
					cfg._selected_key = nil
					local function update_selection()
						if dragging then sel_overlay.Visible = false; cfg._selected_key = nil; return end
						local e, key = pick_hover()
						if not e then sel_overlay.Visible = false; cfg._selected_key = nil; return end
						local vpp = items.viewportframe.AbsolutePosition
						local ap, av = e.AbsolutePosition, e.AbsoluteSize
						sel_overlay.Position = dim2(0, ap.X - vpp.X - 3, 0, ap.Y - vpp.Y - 3)
						sel_overlay.Size = dim2(0, av.X + 6, 0, av.Y + 6)
						sel_overlay.Visible = true
						cfg._selected_key = key
					end

					-- per-frame: move the drag ghost to the cursor + drive the hover selection.
					-- Cheap (a few hover checks); gated to when the preview panel is on-screen.
					library:connection(run.RenderStepped, function()
						if drag_ghost then
							if dragging then
								local m = uis:GetMouseLocation()
								drag_ghost.Position = dim2(0, m.X + 12, 0, m.Y - 6)
							else
								kill_drag_ghost()   -- release missed? clean it up
							end
						end
						if cfg._preview_sg and not cfg._preview_sg.Enabled then
							if sel_overlay.Visible then sel_overlay.Visible = false end
							return
						end
						-- live bar thickness: if the hp_bar_width / ammo_bar_width stat changed,
						-- re-pack that side so the preview bar grows/shrinks with the slider.
						local hw, aw = flags["hp_bar_width"], flags["ammo_bar_width"]
						if hw ~= last_hpw then last_hpw = hw; if placed.healthbar then layout_bars_on_side(placed.healthbar) end end
						if aw ~= last_ammow then last_ammow = aw; if placed.ammo then layout_bars_on_side(placed.ammo) end end
						update_selection()
					end)

					-- ── RIGHT-CLICK SETTINGS POPUP ─────────────────────────────────────────
					-- Applied element -> right-click -> a floating panel of THAT element's ESP
					-- settings. The consumer registers a builder per element key via
					-- properties.panels[key] = function(section, key, ctx); we hand it a REAL
					-- library section parented into the popup, so the builder uses the exact same
					-- control API (toggle/slider/colorpicker/dropdown) bound to the real flags —
					-- editing them drives the live ESP too. Built ONCE per (key,ctx) then just
					-- shown/hidden + repositioned, so opening never re-seeds/clobbers values, and
					-- MAIN vs AI tabs each get their own flag-bound panel. If no panels are
					-- registered the whole thing is inert and right-click stays a no-op.
					local settings_panels = properties.panels or {}
					local settings_pop, settings_body, settings_built, settings_scale
					if next(settings_panels) ~= nil then
						settings_built = {}   -- "key:ctx" -> wrapper frame (lazy, build once)
						-- Sibling ZIndexBehavior: without it the popup frame (a high ZIndex) paints
						-- OVER its own low-ZIndex child controls (they build + size the box but never
						-- show — the empty "black box"). Sibling makes descendants always draw above
						-- ancestors. ZIndex kept at 1 so a colorpicker opened from a control (its holder
						-- is a ZIndex-1 sibling on sgui) still layers above the panel.
						pcall(function() sgui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
						settings_pop = library:create("Frame", {
							Parent = sgui; Name = "\0"; Visible = false; ZIndex = 1;
							BackgroundColor3 = themes.preset.high_contrast; BorderSizePixel = 0;
							AnchorPoint = vec2(0, 0); Size = dim2(0, 226, 0, 0);
							AutomaticSize = Enum.AutomaticSize.Y;
						}) library:apply_theme(settings_pop, "high_contrast", "BackgroundColor3")
						do
							local st = library:create("UIStroke", {
								Parent = settings_pop; Color = themes.preset.accent; Thickness = 1;
								LineJoinMode = Enum.LineJoinMode.Miter;
							}) library:apply_theme(st, "accent", "Color")
						end
						library:create("UICorner", {Parent = settings_pop; CornerRadius = dim(0, 4)})
						settings_scale = library:create("UIScale", {Parent = settings_pop; Scale = 1})
						library:create("UIListLayout", {
							Parent = settings_pop; FillDirection = Enum.FillDirection.Vertical;
							SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 4);
						})
						library:create("UIPadding", {
							Parent = settings_pop; PaddingTop = dim(0, 6); PaddingBottom = dim(0, 8);
							PaddingLeft = dim(0, 6); PaddingRight = dim(0, 6);
						})
						-- header: close button only (each section carries its own titled frame)
						local header = library:create("Frame", {
							Parent = settings_pop; Name = "\0"; LayoutOrder = 0;
							BackgroundTransparency = 1; BorderSizePixel = 0; Size = dim2(1, 0, 0, 14);
						})
						local closeb = library:create("TextButton", {
							Parent = header; Name = "\0"; FontFace = library.font; Text = "\u{2715}";
							TextColor3 = TXT; BackgroundTransparency = 1; TextSize = 13; AutoButtonColor = false;
							AnchorPoint = vec2(1, 0); Position = dim2(1, 0, 0, 0); Size = dim2(0, 16, 1, 0);
						}) library:apply_theme(closeb, "text", "TextColor3")
						library:connection(closeb.MouseButton1Click, function() settings_pop.Visible = false end)
						settings_body = library:create("Frame", {
							Parent = settings_pop; Name = "\0"; LayoutOrder = 1;
							BackgroundTransparency = 1; BorderSizePixel = 0;
							Size = dim2(1, 0, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
						})
						library:create("UIListLayout", {
							Parent = settings_body; FillDirection = Enum.FillDirection.Vertical;
							SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 4);
						})
					end

					-- show_panel: the shared right-click popup. Builds `builder(host)` ONCE into a
					-- titled wrapper keyed by bkey (host = a table whose metatable is `library`, so
					-- host:toggle/slider/colorpicker/dropdown resolve to the real builders and parent
					-- into a plain `content` frame — a section's control surface without its
					-- ScrollingFrame chrome, which rendered as an empty black box in a floating popup),
					-- then shows + tweens it. Used by both the char element panels (open_settings) and
					-- the world chip panels.
					local function show_panel(bkey, title, builder)
						if not settings_pop then return end
						if not settings_built[bkey] then
							local wrap = library:create("Frame", {
								Parent = settings_body; Name = "\0"; Visible = false;
								BackgroundTransparency = 1; BorderSizePixel = 0;
								Size = dim2(1, 0, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
							})
							library:create("UIListLayout", {
								Parent = wrap; FillDirection = Enum.FillDirection.Vertical;
								SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 3);
							})
							local ttl = library:create("TextLabel", {
								Parent = wrap; Name = "\0"; LayoutOrder = 0; FontFace = library.font;
								Text = tostring(title or ""):upper(); TextColor3 = ACCENT; TextSize = 12;
								BackgroundTransparency = 1; BorderSizePixel = 0; Size = dim2(1, 0, 0, 14);
								TextXAlignment = Enum.TextXAlignment.Left;
							}) library:apply_theme(ttl, "accent", "TextColor3")
							local content = library:create("Frame", {
								Parent = wrap; Name = "\0"; LayoutOrder = 1;
								BackgroundTransparency = 1; BorderSizePixel = 0;
								Size = dim2(1, 0, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
							})
							library:create("UIListLayout", {
								Parent = content; FillDirection = Enum.FillDirection.Vertical;
								SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 4);
							})
							local host = setmetatable({holder = content, right_holder = content}, library)
							local okp, errp = pcall(builder, host)
							if not okp then
								warn("[ESP panel " .. tostring(bkey) .. "] " .. tostring(errp))
								pcall(function() library:log("ESP panel '" .. tostring(bkey) .. "' failed: " .. tostring(errp), "ERROR") end)
								library:create("TextLabel", {
									Parent = content; Name = "\0"; FontFace = library.font;
									Text = "settings failed to load"; TextColor3 = TXT; TextSize = 11;
									BackgroundTransparency = 1; BorderSizePixel = 0; Size = dim2(1, 0, 0, 14);
									TextXAlignment = Enum.TextXAlignment.Left;
								})
							end
							settings_built[bkey] = wrap
						end
						for k, w in pairs(settings_built) do w.Visible = (k == bkey) end
						local m = uis:GetMouseLocation()
						-- clean drop-down reveal: appear slightly high + scaled down, then ease into
						-- place (Quad Out) so the "+"-style panel slides/settles instead of popping.
						local tx, ty = m.X + 14, m.Y - 6
						settings_pop.Position = dim2(0, tx, 0, ty - 10)
						settings_scale.Scale = 0.9
						settings_pop.Visible = true
						tween_service:Create(settings_pop, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
							{Position = dim2(0, tx, 0, ty)}):Play()
						tween_service:Create(settings_scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
							{Scale = 1}):Play()
					end
					local function open_settings(key)
						if not settings_panels[key] then return end   -- ctx binds the right flags (player/ai)
						show_panel(tostring(key) .. ":" .. layout_ctx, LABELS[key] or key, function(host)
							settings_panels[key](host, key, layout_ctx)
						end)
					end
					cfg.on_element_rightclick = open_settings

					-- over a selected applied element, right-click opens that element's settings popup.
					library:connection(uis.InputBegan, function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton2
							and cfg._selected_key and cfg.on_element_rightclick then
							pcall(cfg.on_element_rightclick, cfg._selected_key)
						end
					end)

					-- click-off closes the popup. Skips clicks INSIDE the popup (hovering it) and clicks
					-- while a colorpicker/dropdown popup is open (library.current_element_open), so
					-- picking a colour or a dropdown item doesn't dismiss the whole panel.
					library:connection(uis.InputBegan, function(input)
						if input.UserInputType ~= Enum.UserInputType.MouseButton1
							and input.UserInputType ~= Enum.UserInputType.Touch then return end
						if not (settings_pop and settings_pop.Visible) then return end
						if library.current_element_open then return end
						if library:hovering(settings_pop) then return end
						settings_pop.Visible = false
					end)

					-- auto-hide with the UI: when the preview panel / menu is toggled off, the popup
					-- (and any dropdown/colorpicker opened from it) lives on the shared sgui overlay
					-- which stays enabled, so hide them explicitly instead of leaving them stuck on
					-- screen. A dropdown list opened inside the popup floats on that overlay too, so
					-- closing library.current_element_open is what clears the "dropdown stays on close".
					library:connection(run.RenderStepped, function()
						if cfg._preview_sg and not cfg._preview_sg.Enabled then
							if settings_pop and settings_pop.Visible then settings_pop.Visible = false end
							if library.current_element_open then
								pcall(function()
									library.current_element_open.set_visible(false)
									library.current_element_open.open = false
									library.current_element_open = nil
								end)
							end
						end
					end)

					-- Pickup-from-box: press on a PLACED global/bar's drawn visual (the hover selection
					-- under the cursor set cfg._selected_key) to grab and DRAG it — same as dragging a
					-- side chip. Drop on the tray to remove it, or (bars) onto a different side to move
					-- it. This makes every element draggable both ways, so nothing is click-only. A tray
					-- chip press already set `dragging` (we no-op then); hovering a tray chip leaves
					-- cfg._selected_key nil so this can't mis-fire there.
					library:connection(uis.InputBegan, function(input)
						if input.UserInputType ~= Enum.UserInputType.MouseButton1
							and input.UserInputType ~= Enum.UserInputType.Touch then return end
						if dragging then return end
						local key = cfg._selected_key
						if key and (GLOBAL_KEYS[key] or BAR_KEYS[key]) and placed[key] then
							dragging = key; hover_side = nil; hover_before = nil; hover_palette = false
							make_drag_ghost(LABELS[key] or key)
						end
					end)

					-- initial placement: from the esp_layout flag, else the defaults
					local function apply_from_string(str)
						for _, c in ipairs(CHIPS) do
							if placed[c.key] then
								if GLOBAL_KEYS[c.key] or BAR_KEYS[c.key] then cfg._show[c.key] = false
								else objects[c.key].Parent = library.cache end
								placed[c.key] = nil; order[c.key] = nil
							end
						end
						local any = false
						for entry in tostring(str or ""):gmatch("[^,]+") do
							local k, s, ord = entry:match("^([%w_]+):(%w+):([%d%.]+)$")
							if k and s and GLOBAL_KEYS[k] then
								placed[k] = "on"; cfg._show[k] = true; any = true   -- side ignored for globals
							elseif k and s and BAR_KEYS[k] then
								placed[k] = s; cfg._show[k] = true; apply_bar(k, s); any = true   -- bar remembers its side
							elseif k and s and objects[k] and containers[s] then
								objects[k].Parent = containers[s]; placed[k] = s; order[k] = tonumber(ord) or 1; any = true
							end
						end
						if not any and str == nil then   -- only default when the tab was never set (nil, not "")
							for _, c in ipairs(CHIPS) do
								local side = DEFAULT_SIDE[c.key]
								if side and objects[c.key] then objects[c.key].Parent = containers[side]; placed[c.key] = side end
							end
						end
						for _, s in ipairs(SIDES) do relayout(s) end
						refresh_side_offsets()
						refresh_palette()
						-- restored placements turn their real ESP flag ON (this ctx's flags). We only
						-- push ON here — not OFF for unplaced keys — so an existing ESP-tab toggle
						-- isn't silently cleared at load during the toggle->builder transition.
						for k in pairs(REAL_FLAG) do if placed[k] ~= nil then sync_real_flag(k, true) end end
						for k in pairs(STATUS_MAP) do if placed[k] ~= nil then sync_status(k, true) end end
						-- reflect box on/off (its show/hide lives in refresh_elements, not the overlay)
						if cfg.refresh_elements then pcall(cfg.refresh_elements) end
					end
					-- MAIN / AI tab row: a real tab bar ABOVE the preview, in the panel body —
					-- NOT floating over the viewport/character. The section holder is a vertical
					-- UIListLayout, so LayoutOrder decides the stack: tabs(-1) -> preview(0) ->
					-- tray(50). Switches which layout the chips edit; AI writes esp_layout_ai.
					items.viewportframe.LayoutOrder = 0
					local tabbar = library:create("Frame", {
						Parent = self.holder; Name = "\0"; LayoutOrder = -1;
						Size = dim2(1, -8, 0, 16);
						BackgroundTransparency = 1; BorderSizePixel = 0; ZIndex = 7;
					})
					library:create("UIListLayout", {
						Parent = tabbar; FillDirection = Enum.FillDirection.Horizontal;
						HorizontalAlignment = Enum.HorizontalAlignment.Left;
						VerticalAlignment = Enum.VerticalAlignment.Center;
						SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 4);
					})
					local tab_btns = {}
					local function make_tab(id, label, ord)
						local b = library:create("TextButton", {
							Parent = tabbar; Name = "\0"; Active = true; AutoButtonColor = false;
							FontFace = library.font; Text = label; TextSize = 12; LayoutOrder = ord;
							TextColor3 = themes.preset.text; BackgroundTransparency = 1;   -- no glow; text-only
							BorderSizePixel = 0; AutomaticSize = Enum.AutomaticSize.X; Size = dim2(0, 0, 1, 0); ZIndex = 7;
						})
						library:create("UIPadding", {Parent = b; PaddingLeft = dim(0, 5); PaddingRight = dim(0, 5)})
						tab_btns[id] = b
						return b
					end

					-- ── WORLD CONTEXTS (Body / Exit / Item / Container) ────────────────────────
					-- Non-character ESP. Each context is an on/off chip set over the real world-ESP
					-- flags: click a chip to toggle it, right-click for its settings. The preview is
					-- EMPTY for these (character + box hidden). Driven by properties.world_contexts:
					--   { {ctx, label, master, chips = { {key, label, flag, panel?}, ... }}, ... }
					local world_defs = properties.world_contexts or {}
					local WORLD = {}
					for _, d in ipairs(world_defs) do WORLD[d.ctx] = d end
					local function is_world(ctx) return WORLD[ctx] ~= nil end

					-- world chip tray: stacks in the section like the char tray, shown only while a
					-- world context is active; holds a per-context wrapping row of on/off chips.
					local world_tray = library:create("Frame", {
						Parent = self.holder; Name = "\0"; LayoutOrder = 50; Visible = false;
						Size = dim2(1, -8, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
						BackgroundTransparency = 1; BorderSizePixel = 0;
					})
					local world_frames = {}
					local function world_master_refresh(def)
						local anyOn = false
						for _, c in ipairs(def.chips) do if flags[c.flag] == true then anyOn = true; break end end
						flags[def.master] = anyOn
					end
					for _, def in ipairs(world_defs) do
						local wf = library:create("Frame", {
							Parent = world_tray; Name = "\0"; Visible = false;
							Size = dim2(1, 0, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
							BackgroundTransparency = 1; BorderSizePixel = 0;
						})
						local wl = library:create("UIListLayout", {
							Parent = wf; FillDirection = Enum.FillDirection.Horizontal;
							HorizontalAlignment = Enum.HorizontalAlignment.Left;
							SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 6);
						})
						pcall(function() wl.Wraps = true end)
						world_frames[def.ctx] = wf
						for i, chip in ipairs(def.chips) do
							local btn = library:create("TextLabel", {
								Parent = wf; Name = "\0"; Active = true; FontFace = library.font;
								Text = chip.label; TextColor3 = TXT; BackgroundColor3 = ACCENT;
								BackgroundTransparency = 1; BorderSizePixel = 0; LayoutOrder = i;
								AutomaticSize = Enum.AutomaticSize.X; Size = dim2(0, 0, 0, 16); TextSize = 12;
							})
							library:create("UICorner", {Parent = btn; CornerRadius = dim(0, 3)})
							library:create("UIPadding", {Parent = btn; PaddingLeft = dim(0, 5); PaddingRight = dim(0, 5)})
							local function paint() btn.BackgroundTransparency = (flags[chip.flag] == true) and 0.35 or 1 end
							paint()
							library:connection(btn.InputBegan, function(input)
								if input.UserInputType == Enum.UserInputType.MouseButton1
									or input.UserInputType == Enum.UserInputType.Touch then
									flags[chip.flag] = not (flags[chip.flag] == true)   -- click toggles on/off
									world_master_refresh(def)
									paint()
									if properties.on_apply then pcall(properties.on_apply, chip.key, flags[chip.flag], def.ctx) end
								elseif input.UserInputType == Enum.UserInputType.MouseButton2 and chip.panel then
									show_panel("w:" .. def.ctx .. ":" .. chip.key, chip.label, function(host) chip.panel(host, chip, def) end)
								end
							end)
						end
					end
					local function show_world_ctx(ctx)
						for id, wf in pairs(world_frames) do wf.Visible = (id == ctx) end
						world_tray.Visible = (ctx ~= nil)
					end
					-- char-preview visibility: hide the cloned character + box overlays + the char
					-- chip system (tray + side lanes) for world contexts, so their preview is empty.
					local function show_char_preview(on)
						if character then character.Parent = on and items.viewportframe or library.cache end
						if objects.holder then objects.holder.Visible = on end
						if tray_wrap then tray_wrap.Visible = on end
						for _, s in ipairs(SIDES) do if containers[s] then containers[s].Visible = on end end
						if sel_overlay and not on then sel_overlay.Visible = false end
					end

					-- ── CONTEXT FOOTER (Enabled toggle + Render Distance + …) ──────────────────
					-- Per-context controls shown BELOW the tray (matches the reference). Built once
					-- per ctx from properties.context_footers[ctx](section, ctx), then shown/hidden on
					-- switch. Host = a `library`-metatabled table, so section:toggle/slider work.
					local footer_defs = properties.context_footers or {}
					local footer_tray = library:create("Frame", {
						Parent = self.holder; Name = "\0"; LayoutOrder = 60;
						Size = dim2(1, -8, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
						BackgroundTransparency = 1; BorderSizePixel = 0;
					})
					library:create("UIListLayout", {
						Parent = footer_tray; FillDirection = Enum.FillDirection.Vertical;
						SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 3);
					})
					local footer_frames = {}
					local function show_footer(ctx)
						if footer_defs[ctx] and not footer_frames[ctx] then
							local wrap = library:create("Frame", {
								Parent = footer_tray; Name = "\0"; Visible = false;
								Size = dim2(1, 0, 0, 0); AutomaticSize = Enum.AutomaticSize.Y;
								BackgroundTransparency = 1; BorderSizePixel = 0;
							})
							library:create("UIListLayout", {
								Parent = wrap; FillDirection = Enum.FillDirection.Vertical;
								SortOrder = Enum.SortOrder.LayoutOrder; Padding = dim(0, 3);
							})
							local host = setmetatable({holder = wrap, right_holder = wrap}, library)
							pcall(footer_defs[ctx], host, ctx)
							footer_frames[ctx] = wrap
						end
						for id, w in pairs(footer_frames) do w.Visible = (id == ctx) end
					end

					local function set_context(ctx)
						if ctx == layout_ctx then return end
						-- close the settings popup (+ any open dropdown) from the tab we're leaving,
						-- so it can't linger over — or half-apply into — the tab we're entering.
						if settings_pop and settings_pop.Visible then settings_pop.Visible = false end
						if library.current_element_open then
							pcall(function()
								library.current_element_open.set_visible(false)
								library.current_element_open.open = false
								library.current_element_open = nil
							end)
						end
						if not is_world(layout_ctx) then save_layout() end   -- persist the CHAR tab we leave
						layout_ctx = ctx
						show_footer(ctx)
						if is_world(ctx) then
							-- world context: empty the preview + show this context's on/off chip set
							show_char_preview(false)
							show_world_ctx(ctx)
						else
							-- char context: restore the character preview + its chip layout. pcall so a
							-- bad saved layout can't hard-break the switch (was the intermittent "AI tab
							-- breaks").
							show_world_ctx(nil)
							show_char_preview(true)
							local ok, err = pcall(apply_from_string, flags[lflag()])
							if not ok then
								warn("[ESP tab " .. tostring(ctx) .. "] " .. tostring(err))
								pcall(function() library:log("ESP tab switch to '" .. tostring(ctx) .. "' failed: " .. tostring(err), "ERROR") end)
							end
							save_layout()
						end
						for k, b in pairs(tab_btns) do
							-- no background glow: only the TEXT colour changes (accent = selected),
							-- read live so it follows the current theme (accent/text), not a stale blue
							b.TextColor3 = (k == ctx) and themes.preset.accent or themes.preset.text
						end
					end

					make_tab("player", "MAIN", 1).MouseButton1Click:Connect(function() set_context("player") end)
					make_tab("ai",     "AI",   2).MouseButton1Click:Connect(function() set_context("ai") end)
					-- world-context tabs (Body / Exit / Item / Container), from properties.world_contexts
					do
						local ord = 3
						for _, def in ipairs(world_defs) do
							local id = def.ctx
							make_tab(id, def.label, ord).MouseButton1Click:Connect(function() set_context(id) end)
							ord = ord + 1
						end
					end

					-- initial: MAIN tab, from esp_layout (else defaults)
					apply_from_string(flags[lflag()])
					save_layout()
					show_footer("player")   -- initial context footer (Enabled + Render Distance)
					tab_btns.player.TextColor3 = themes.preset.accent

					-- config load re-applies whichever layout is showing (both tabs get a setter)
					if library.config_flags then
						local function setter(fl)
							return function(v)
								pcall(function()
									flags[fl] = tostring(v or "")
									if lflag() == fl then apply_from_string(flags[fl]) end
								end)
							end
						end
						library.config_flags["esp_layout"]    = setter("esp_layout")
						library.config_flags["esp_layout_ai"] = setter("esp_layout_ai")
					end
				end)
				if not _esp_ok then
					warn("[ESP builder] failed: " .. tostring(_esp_err))
					pcall(function() library:log("ESP builder failed: " .. tostring(_esp_err), "ERROR") end)
				end

				return setmetatable(cfg, library)
			end

