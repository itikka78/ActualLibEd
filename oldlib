			function library:get_config()
				-- snapshot the live UI positions (dock, keybind list, every window panel,
				-- watermark) into flags["ui_positions"] so they save with the config
				if type(library.capture_ui_positions) == "function" then
					pcall(function() library:capture_ui_positions() end)
				end
				local Config = {}

				for _, v in flags do
					if type(v) == "table" and v.key then
						Config[_] = {active = v.active, mode = v.mode, key = tostring(v.key)}
					elseif type(v) == "table" and v["Transparency"] and v["Color"] then
						Config[_] = {Transparency = v["Transparency"], Color = v["Color"]:ToHex()}
					else
						Config[_] = v
					end
				end 
				
				return http_service:JSONEncode(Config)
			end

			function library:load_config(config_json) 
				local config = http_service:JSONDecode(config_json)
			
				for _, v in next, config do 
					local function_set = library.config_flags[_]
					
					if function_set then 
						if type(v) == "table" and v["Transparency"] and v["Color"] then
							function_set(hex(v["Color"]), v["Transparency"])
						elseif type(v) == "table" and v["active"] then 
							function_set(v)
						else 
							function_set(v)
						end
					end 
				end 
				-- re-apply the saved main font (restoring the list selection alone doesn't re-font
				-- the menu). A missing/unresolvable font falls back to Default inside apply_saved_font.
				if type(library.apply_saved_font) == "function" then
					pcall(function() library:apply_saved_font() end)
				end
			end

			-- UI position persistence. Any draggable registered via draggify(frame, key) — the
			-- dock, keybind list, every window panel and the watermark — gets its Position saved
			-- with the config and restored on load. Positions are offset-only (draggify always
			-- writes dim2(0,x,0,y)), so capture stores {xOffset, yOffset} and restore is a plain
			-- set. capture runs inside get_config; the config_flags setter below runs on load.
			function library:capture_ui_positions()
				if not library.ui_draggables then return end
				local out = {}
				for key, frame in pairs(library.ui_draggables) do
					if frame and frame.Parent then
						local ok, pos = pcall(function() return frame.Position end)
						local ok2, size = pcall(function() return frame.Size end)
						if ok then
							local entry = { pos.X.Offset, pos.Y.Offset }
							-- entries 3 & 4 hold the frame's size (offset) so RESIZED windows persist
							-- too. All registered draggables are offset-sized roots (scale 0), so the
							-- offset alone round-trips; older configs without them skip size restore.
							if ok2 then entry[3] = size.X.Offset; entry[4] = size.Y.Offset end
							out[key] = entry
						end
					end
				end
				flags["ui_positions"] = out
			end
			library.config_flags["ui_positions"] = function(v)
				if type(v) ~= "table" then return end
				flags["ui_positions"] = v   -- keep it so a later re-save carries it forward
				if not library.ui_draggables then return end
				for key, pos in pairs(v) do
					local frame = library.ui_draggables[key]
					if frame and frame.Parent and type(pos) == "table" then
						local x, y = tonumber(pos[1]), tonumber(pos[2])
						if x and y then pcall(function() frame.Position = dim2(0, x, 0, y) end) end
						-- restore saved size (offset) if present (newer configs only)
						local w, h = tonumber(pos[3]), tonumber(pos[4])
						if w and h then pcall(function() frame.Size = dim2(0, w, 0, h) end) end
					end
				end
			end

			-- Autoload: a small marker file (autoload.txt in the menu directory) holds the name
			-- of the config to load automatically when the script runs. Set/cleared by the two
			-- buttons in the Configs tab; consumed once at load by delta calling library:autoload().
			function library:autoload_name()
				local marker = library.directory .. "/autoload.txt"
				if not (isfile and isfile(marker)) then return nil end
				local ok, name = pcall(readfile, marker)
				if not ok or type(name) ~= "string" then return nil end
				name = name:gsub("^%s+", ""):gsub("%s+$", "")
				if name == "" then return nil end
				return name
			end
			
			function library:autoload()
				local name = library:autoload_name()
				if not name then return nil end
				local cfg_path = library.directory .. "/configs/" .. name .. ".cfg"
				if not (isfile and isfile(cfg_path)) then return nil end
				local ok, data = pcall(readfile, cfg_path)
				if not (ok and data) then return nil end
				pcall(function() library:load_config(data) end)
				return name
			end
			
			function library:round(number, float) 
				local multiplier = 1 / (float or 1)

				return floor(number * multiplier + 0.5) / multiplier
			end 

			function library:apply_theme(instance, theme, property)
				-- guard: an unknown theme/property combo (e.g. "inline"/"Color" when that channel
				-- has no such list) made insert() throw "table expected, got nil" and abort the
				-- CALLER — that's what silently killed the ESP builder. Skip instead of crashing.
				local channel = themes.utility[theme]
				local list = channel and channel[property]
				if not list then return end
				insert(list, instance)
			end

			function library:update_theme(theme, color)
				for _, property in next, themes.utility[theme] do

					for m, object in next, property do
						if object[_] == themes.preset[theme] or object.ClassName == "UIGradient" then
							object[_] = color
						end
					end
				end

				themes.preset[theme] = color

				-- a flat repaint wipes the per-element two-tone colours, so re-spread
				-- whenever the base colour of a two-toned channel moves
				if library.two_tone and (theme == "accent" or theme == "glow") then
					library:refresh_two_tone()
				end
			end

			-- Two-tone: instead of one flat accent, every accented element takes the colour
			-- at ITS horizontal position across the window — left edge = colour A, right edge
			-- = colour B. Each element stays a flat colour (only the window glow and the top
			-- bar are real gradients), which is what makes the whole menu read as one ramp.
			--
			-- This deliberately bypasses update_theme's `object[_] == preset` guard: that guard
			-- exists so a repaint only touches elements still on the old colour, but here every
			-- element is legitimately a DIFFERENT colour, so it would skip all of them.
			function library:refresh_two_tone()
				local root = library.two_tone_root
				if not (library.two_tone and root and root.Parent) then return end
				local x0, w = root.AbsolutePosition.X, root.AbsoluteSize.X
				if w <= 0 then return end

				local function spread(channel, a, b)
					for property, objects in next, themes.utility[channel] do
						for _, object in next, objects do
							-- UIGradients hold a ColorSequence, not a Color3: give them the
							-- full A->B ramp so big elements (glow, accent bar) sweep properly
							if object.ClassName == "UIGradient" then
								object[property] = rgbseq{rgbkey(0, a), rgbkey(1, b)}
							else
								local ok, pos = pcall(function() return object.AbsolutePosition end)
								local ok2, size = pcall(function() return object.AbsoluteSize end)
								if ok and ok2 then
									-- sample at the element's CENTRE, clamped so popups and
									-- panels parked outside the window still get an endpoint
									local t = math.clamp(((pos.X + size.X * 0.5) - x0) / w, 0, 1)
									object[property] = a:Lerp(b, t)
								end
							end
						end
					end
				end

				spread("accent", themes.preset.accent, library.accent_2 or themes.preset.accent)
				spread("glow",   themes.preset.glow,   library.glow_2   or themes.preset.glow)
			end

